# This repository lives inside a full Odoo development workspace.  Track only
# the Government HR deliverables; never vendor Odoo Community or Enterprise.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/DESIGN.md
!/PRODUCT.md
!/custom_addons/
!/docs/
!/scripts/

/custom_addons/*
!/custom_addons/gov_hr_base/
!/custom_addons/gov_hr_deputation/
!/custom_addons/dma_accreditation/
!/custom_addons/legal_core/
!/custom_addons/legal_correspondence/
!/custom_addons/legal_procedure/
!/custom_addons/legal_iq_registrar/
!/custom_addons/legal_iq_tax/
!/custom_addons/legal_iq_chamber/
!/custom_addons/legal_iq_social_security/
!/custom_addons/legal_iq_residency/
!/custom_addons/legal_iq_demo/
!/custom_addons/legal_request/
!/custom_addons/legal_contract/
!/custom_addons/legal_litigation/
!/custom_addons/legal_opinion/
!/custom_addons/legal_deadline/
!/custom_addons/legal_reports/
!/custom_addons/legal_office/

/docs/*
!/docs/access_schema_analysis.md
!/docs/access_to_odoo_mapping.md
!/docs/architecture.md
!/docs/deployment.md
!/docs/reporting.md
!/docs/reuse_audit.md
!/docs/security_matrix.md
!/docs/test_users.md
!/docs/workflow.md
!/docs/PROGRESS.md
!/docs/ui-audit/

/scripts/*
!/scripts/setup_gov_hr_test_users.py
!/scripts/dma_odoo_start.cmd
!/scripts/dma_odoo_stop.cmd
!/scripts/dma_install_into_odoo_service.ps1
!/scripts/legal_ui_capture.py
!/scripts/legal_stamp_view_class.py

__pycache__/
*.py[cod]
*.log
*.pot
*.zip
.DS_Store
Thumbs.db
.idea/
.vscode/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/
