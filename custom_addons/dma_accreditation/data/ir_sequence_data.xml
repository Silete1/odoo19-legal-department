<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_dma_accreditation_request" model="ir.sequence">
            <field name="name">DMA Accreditation Request</field>
            <field name="code">dma.accreditation.request</field>
            <field name="prefix">DMA/ACC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_dma_accreditation_office" model="ir.sequence">
            <field name="name">DMA Office Accreditation</field>
            <field name="code">dma.accreditation.office</field>
            <field name="prefix">DMA/OFF/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_dma_accreditation_certificate" model="ir.sequence">
            <field name="name">DMA Operational Accreditation Certificate</field>
            <field name="code">dma.accreditation.certificate</field>
            <field name="prefix">DMA/CERT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Directorate wide defaults, editable from Configuration > Settings. -->
        <record id="dma_param_sop_fee" model="ir.config_parameter">
            <field name="key">dma_accreditation.sop_fee</field>
            <field name="value">250.0</field>
        </record>

        <record id="dma_param_demo_fee" model="ir.config_parameter">
            <field name="key">dma_accreditation.demo_fee</field>
            <field name="value">500.0</field>
        </record>

        <record id="dma_param_validity_months" model="ir.config_parameter">
            <field name="key">dma_accreditation.validity_months</field>
            <field name="value">12</field>
        </record>

    </data>
</odoo>
