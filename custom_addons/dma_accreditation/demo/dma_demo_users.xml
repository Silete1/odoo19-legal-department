        <!-- ================================================================
             Applicant organisations
             ================================================================ -->
        <record id="demo_partner_alamal" model="res.partner">
            <field name="name">Al-Amal Demining Company</field>
            <field name="is_company" eval="True"/>
            <field name="email">contact@al-amal-demining.example.com</field>
            <field name="phone">+964 770 111 2233</field>
            <field name="street">Al-Mansour District</field>
            <field name="city">Baghdad</field>
        </record>

        <record id="demo_partner_alamal_contact" model="res.partner">
            <field name="name">Layla Hassan</field>
            <field name="parent_id" ref="demo_partner_alamal"/>
