#. module: dma_accreditation
#: model:mail.template,body_html:dma_accreditation.mail_template_operational_granted
msgid ""
"<div dir=\"rtl\" style=\"font-family: 'Segoe UI', Tahoma, Arial, sans-serif; font-size: 14px; color: #1f2937;\">\n"
"    <p>السادة <t t-out=\"object.partner_id.name or ''\"/> المحترمين،</p>\n"
"    <p>\n"
"        استناداً إلى قرار <b>لجنة منح التفويض</b> الصادر بتاريخ\n"
"        <b><t t-out=\"object.committee_date or ''\"/></b> وبعد إتمام\n"
"        <b>التنقيح القانوني</b> للقرار، تم منح مؤسستكم\n"
"        <b>تفويض العمليات</b> بموجب الشهادة المرقمة\n"
"        <b><t t-out=\"object.certificate_ref or ''\"/></b>.\n"
"    </p>\n"
"    <table style=\"border-collapse: collapse; margin: 12px 0;\">\n"
"        <tr>\n"
"            <td style=\"padding: 4px 12px; border: 1px solid #e5e7eb;\"><b>تاريخ الإصدار</b></td>\n"
"            <td style=\"padding: 4px 12px; border: 1px solid #e5e7eb;\"><t t-out=\"object.issue_date or ''\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 4px 12px; border: 1px solid #e5e7eb;\"><b>تاريخ الانتهاء</b></td>\n"
"            <td style=\"padding: 4px 12px; border: 1px solid #e5e7eb;\"><t t-out=\"object.expiry_date or ''\"/></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 4px 12px; border: 1px solid #e5e7eb;\"><b>نطاقات التفويض</b></td>\n"
"            <td style=\"padding: 4px 12px; border: 1px solid #e5e7eb;\"><t t-out=\"', '.join(object.scope_ids.mapped('name')) or '-'\"/></td>\n"
"        </tr>\n"
"    </table>\n"
"    <p>\n"
"        يتوجب الالتزام بالمعايير الوطنية وبالإجراءات التشغيلية المعتمدة طوال\n"
"        فترة سريان التفويض، ويخضع التفويض للمراقبة والتقييم من قبل الدائرة.\n"
"    </p>\n"
"    <p>مع فائق الاحترام والتقدير،<br/>دائرة شؤون الألغام</p>\n"
"</div>\n"
"<div dir=\"ltr\" style=\"font-family: 'Segoe UI', Tahoma, Arial, sans-serif; font-size: 12px; color: #6b7280; border-top: 1px solid #e5e7eb; margin-top: 16px; padding-top: 8px;\">\n"
"    <p>\n"
"        <b>English summary:</b> the Operational Accreditation of\n"
"        <t t-out=\"object.partner_id.name or ''\"/> has been granted under certificate\n"
"        <t t-out=\"object.certificate_ref or ''\"/>, valid from\n"
"        <t t-out=\"object.issue_date or ''\"/> to <t t-out=\"object.expiry_date or ''\"/>.\n"
"    </p>\n"
"</div>\n"
"            "
