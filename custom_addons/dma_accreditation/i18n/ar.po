#. module: dma_accreditation
#: model:ir.model.constraint,message:dma_accreditation.constraint_dma_sla_rule_warning_positive
msgid ""
"The warning and escalation delays of a service level cannot be negative."
msgstr "لا يجوز أن تكون مدتا التنبيه والتصعيد لمستوى الخدمة سالبتين."

#. module: dma_accreditation
#. odoo-python
#: code:addons/dma_accreditation/models/dma_sla_rule.py:0
