#. module: dma_accreditation
#: model:mail.template,body_html:dma_accreditation.mail_template_office_granted
msgid ""
"<div dir=\"rtl\" style=\"font-family: 'Segoe UI', Tahoma, Arial, sans-serif; font-size: 14px; color: #1f2937;\">\n"
"    <p>السادة <t t-out=\"object.partner_id.name or ''\"/> المحترمين،</p>\n"
"    <p>\n"
"        تحية طيبة وبعد،\n"
"    </p>\n"
"    <p>\n"
"        يسر <b>دائرة شؤون الألغام</b> إشعاركم بأنه تم منح مؤسستكم\n"
"        <b>التفويض المكتبي</b> بموجب الطلب المرقم\n"
"        <b><t t-out=\"object.name or ''\"/></b> وبالإشارة الرسمية\n"
"        <b><t t-out=\"object.office_ref or ''\"/></b> بتاريخ\n"
"        <b><t t-out=\"object.office_date or ''\"/></b>.\n"
"    </p>\n"
"    <p>\n"
"        نطاقات العمل المشمولة بالتفويض:\n"
"        <b><t t-out=\"', '.join(object.scope_ids.mapped('name')) or '-'\"/></b>\n"
"    </p>\n"
"    <p>\n"
"        يرجى التفضل بالمباشرة بإجراءات <b>تفويض العمليات</b>، وذلك بتقديم\n"
"        إجراءات التشغيل القياسية (SOP) بنسختيها الورقية والإلكترونية إلى\n"
"        قسم العمليات، وتسديد رسوم قراءة الإجراءات التشغيلية.\n"
"    </p>\n"
"    <p>مع فائق الاحترام والتقدير،<br/>دائرة شؤون الألغام</p>\n"
"</div>\n"
"<div dir=\"ltr\" style=\"font-family: 'Segoe UI', Tahoma, Arial, sans-serif; font-size: 12px; color: #6b7280; border-top: 1px solid #e5e7eb; margin-top: 16px; padding-top: 8px;\">\n"
"    <p>\n"
"        <b>English summary:</b> the Directorate of Mine Action has granted the\n"
"        <b>Office Accreditation</b> of <t t-out=\"object.partner_id.name or ''\"/> under\n"
"        reference <t t-out=\"object.office_ref or ''\"/> dated\n"
"        <t t-out=\"object.office_date or ''\"/>. Please proceed with the Operational\n"
"        Accreditation phase by submitting your SOP in both paper and electronic\n"
"        form and by settling the SOP reading fee.\n"
"    </p>\n"
"</div>\n"
"            "
