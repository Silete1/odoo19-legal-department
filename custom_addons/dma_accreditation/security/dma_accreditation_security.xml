<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Application category and privilege
         Odoo 19 groups a set of related res.groups under a
         res.groups.privilege, itself attached to an ir.module.category.
         ================================================================ -->
    <record id="module_category_dma_accreditation" model="ir.module.category">
        <field name="name">DMA Accreditation</field>
        <field name="description">Accreditation of demining organisations by the Directorate of Mine Action.</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_dma_accreditation" model="res.groups.privilege">
        <field name="name">DMA Accreditation</field>
        <field name="description">Role of the user inside the accreditation process.</field>
        <field name="category_id" ref="module_category_dma_accreditation"/>
        <field name="sequence">10</field>
    </record>

    <!-- ================================================================
         Roles - one group per department taking part in the process.
         Each of them implies the internal user group.
         ================================================================ -->
    <record id="group_dma_reception" model="res.groups">
        <field name="name">Reception Officer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_dma_accreditation"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Creates accreditation requests and submits them to the General Director.</field>
    </record>

    <record id="group_dma_general_director" model="res.groups">
        <field name="name">General Director</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_dma_accreditation"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Gives the initial acceptance of an accreditation request.</field>
    </record>

    <record id="group_dma_legal_director" model="res.groups">
        <field name="name">Legal Department Director</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_dma_accreditation"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Reviews the request legally and refines the committee decision.</field>
    </record>

    <record id="group_dma_cert_officer" model="res.groups">
        <field name="name">Certifications Division Officer</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_dma_accreditation"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Verifies the prerequisites checklist and grants the office accreditation.</field>
    </record>

    <record id="group_dma_operations" model="res.groups">
        <field name="name">Operations Department</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_dma_accreditation"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Records the reception of the SOP and confirms it for appraisal.</field>
    </record>

    <record id="group_dma_finance" model="res.groups">
        <field name="name">Finance Department</field>
        <field name="sequence">60</field>
        <field name="privilege_id" ref="res_groups_privilege_dma_accreditation"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Confirms the accreditation fees and the receipt of the request.</field>
    </record>

    <record id="group_dma_committee" model="res.groups">
        <field name="name">Accreditation Committee</field>
        <field name="sequence">70</field>
        <field name="privilege_id" ref="res_groups_privilege_dma_accreditation"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Records the decision of the accreditation granting committee.</field>
    </record>

    <!-- The manager implies every role: it can act on any step and owns the
         configuration menus. -->
    <record id="group_dma_manager" model="res.groups">
        <field name="name">Accreditation Manager</field>
        <field name="sequence">80</field>
        <field name="privilege_id" ref="res_groups_privilege_dma_accreditation"/>
        <field name="implied_ids" eval="[(6, 0, [
            ref('base.group_user'),
            ref('group_dma_reception'),
            ref('group_dma_general_director'),
            ref('group_dma_legal_director'),
            ref('group_dma_cert_officer'),
            ref('group_dma_operations'),
            ref('group_dma_finance'),
            ref('group_dma_committee'),
        ])]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access to every step, to the configuration and to the archives.</field>
    </record>

</odoo>
