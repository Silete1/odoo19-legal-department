<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dma_accreditation.AccreditationProgress">
        <!-- data-state / data-pending-role are stable technical hooks: they let
             a tour or any automation target a step without matching translated
             text. -->
        <section class="o_dma_progress" t-att-dir="payload.rtl ? 'rtl' : 'ltr'"
                 t-att-data-state="payload.current"
                 t-att-data-pending-role="payload.pending_role_key || ''"
                 t-att-data-blockers="blockers.length">

            <div class="o_dma_progress_head">
                <span class="o_dma_progress_state" t-esc="payload.current_label"/>
                <!-- "Is this waiting for me?" is the question the reader opens
                     the file with, and the server already knows the answer, so
                     they should not have to match the module's role vocabulary
                     against their own group memberships to work it out. -->
                <span class="o_dma_progress_mine" t-if="payload.mine">
                    <i class="fa fa-hand-o-right" role="img" aria-hidden="true"/><t>&#160;</t>
                    <t t-esc="label.mine"/>
                </span>
                <span class="o_dma_progress_pending"
                      t-if="pendingRoles.length &amp;&amp; !payload.closed &amp;&amp; !payload.mine">
                    <t t-esc="label.blocked"/><t>&#160;</t>
                    <!-- Both departments during the parallel step. "+" rather
                         than a comma: it needs no bidi handling in Arabic. -->
                    <t t-foreach="pendingRoles" t-as="role" t-key="role_index">
                        <t t-if="!role_first">&#160;+&#160;</t><b t-esc="role"/>
                    </t>
                </span>
                <!-- dir="ltr": a bare "4 / 13" is reordered to "13 / 4" by the
                     bidi algorithm inside an Arabic paragraph. -->
                <span class="o_dma_progress_counter" dir="ltr">
                    <t t-esc="payload.steps_done"/> / <t t-esc="payload.steps_total"/>
                </span>
            </div>

            <div class="o_dma_progress_bar" role="progressbar"
                 t-att-aria-valuenow="payload.percent" aria-valuemin="0" aria-valuemax="100"
                 t-att-aria-label="label.progress">
                <div class="o_dma_progress_bar_fill"
                     t-attf-style="width: {{ payload.percent }}%;"/>
            </div>

            <ol class="o_dma_rail" t-att-aria-label="label.progress">
                <li t-foreach="steps" t-as="step" t-key="step.key"
                    t-att-class="stepClass(step)" tabindex="0"
                    t-att-aria-current="step.status === 'current' ? 'step' : false"
                    t-att-data-tooltip="stepTitle(step)">
                    <span class="o_dma_step_marker">
                        <i class="fa fa-check" t-if="step.status === 'done'" role="img"
                           aria-hidden="true"/>
                        <t t-else="" t-esc="step.number"/>
                    </span>
                    <span class="o_dma_step_label" t-esc="step.label"/>
                    <!-- Status in words as well as in colour, so the rail is
                         readable without seeing the border tint and audible to
                         a screen reader. -->
                    <span class="visually-hidden" t-esc="statusLabel(step)"/>
                    <span class="o_dma_step_role" t-esc="step.role"/>
                    <span class="o_dma_step_user" t-if="step.user" t-esc="step.user"/>
                </li>
            </ol>

            <div class="o_dma_blockers alert alert-warning" role="alert"
                 t-if="blockers.length &amp;&amp; !payload.closed">
                <div class="o_dma_blockers_title" t-esc="label.blockers"/>
                <ul>
                    <li t-foreach="blockers" t-as="blocker" t-key="blocker_index"
                        t-esc="blocker"/>
                </ul>
            </div>

            <!-- No exception banner here. "Returned" and "Rejected" are stated
                 by the status bar and, with the reason and the step the file
                 resumes at - which is the part that matters - by the alert
                 above the sheet. A third echo inside the rail only interrupts
                 the rail's own job. The payload still carries `exception` for
                 automation. -->
        </section>
    </t>

</templates>
