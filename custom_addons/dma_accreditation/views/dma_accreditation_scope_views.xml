<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dma_accreditation_scope_view_list" model="ir.ui.view">
        <field name="name">dma.accreditation.scope.list</field>
        <field name="model">dma.accreditation.scope</field>
        <field name="arch" type="xml">
            <list string="Accreditation Scopes" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description" optional="show"/>
                <field name="color" widget="color_picker" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="dma_accreditation_scope_view_form" model="ir.ui.view">
        <field name="name">dma.accreditation.scope.form</field>
        <field name="model">dma.accreditation.scope</field>
        <field name="arch" type="xml">
            <form string="Accreditation Scope">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Battle Area Clearance"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. BAC"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dma_accreditation_scope" model="ir.actions.act_window">
        <field name="name">Accreditation Scopes</field>
        <field name="res_model">dma.accreditation.scope</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define the demining activities an organisation can be accredited for.
            </p><p>
                The scopes follow IMAS 07.30: manual clearance, battle area
                clearance, EOD, mine detection dogs, mechanical demining,
                technical and non-technical survey and EORE.
            </p>
        </field>
    </record>

</odoo>
