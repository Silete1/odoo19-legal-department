<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The module ships its own settings model rather than extending
         res.config.settings: saving that one is reserved to users of
         "Administration / Settings", which the Accreditation Manager is not. -->
    <record id="dma_accreditation_settings_view_form" model="ir.ui.view">
        <field name="name">dma.accreditation.settings.form</field>
        <field name="model">dma.accreditation.settings</field>
        <field name="arch" type="xml">
            <form string="Accreditation Settings">
                <!-- No oe_title: the dialog header already carries the action
                     name, and a second heading one line below it read as a
                     different screen. The look is borrowed from a settings
                     screen - one stacked column, each value carrying its unit
                     beside the input and its explanation underneath - without
                     switching to res.config.settings, which the Accreditation
                     Manager would not be allowed to save. -->
                <field name="currency_id" invisible="1"/>
                <group>
                    <label for="sop_fee"/>
                    <div name="sop_fee_setting">
                        <field name="sop_fee" class="oe_inline"/>
                        <div class="text-muted">
                            Proposed by default on a new SOP reading fee line. The
                            Finance Department can still record a different amount
                            against the receipt.
                        </div>
                    </div>
                    <label for="demo_fee"/>
                    <div name="demo_fee_setting">
                        <field name="demo_fee" class="oe_inline"/>
                        <div class="text-muted">
                            Proposed by default on a new operational demonstration
                            fee line.
                        </div>
                    </div>
                    <label for="validity_months"/>
                    <div name="validity_setting">
                        <field name="validity_months" class="oe_inline w-25"/>
                        <span class="ms-1">months</span>
                        <div class="text-muted">
                            How long an operational accreditation certificate stays
                            valid. It sets the expiry date printed on the certificate
                            when the accreditation is issued.
                        </div>
                    </div>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Save"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dma_accreditation_settings" model="ir.actions.act_window">
        <field name="name">Accreditation Settings</field>
        <field name="res_model">dma.accreditation.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="dma_accreditation_settings_view_form"/>
        <field name="target">new</field>
        <!-- Three numeric inputs do not need the default large modal. -->
        <field name="context">{'dialog_size': 'medium'}</field>
    </record>

</odoo>
