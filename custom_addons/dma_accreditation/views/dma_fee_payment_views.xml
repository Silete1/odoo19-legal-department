<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The list of fee lines *inside* a request: the request is implied, so it
         is not a column, and the officer edits the lines in place. -->
    <record id="dma_fee_payment_view_list" model="ir.ui.view">
        <field name="name">dma.fee.payment.list</field>
        <field name="model">dma.fee.payment</field>
        <field name="arch" type="xml">
            <!-- The two fees of a file are sequential - the SOP reading fee
                 then the demonstration fee - so they read oldest first, and a
                 line appended at the bottom stays where it was typed.
                 No row decoration: in Odoo a muted row means cancelled or
                 archived, so painting the *confirmed* ones grey said the
                 opposite of what happened. The badge carries the status. -->
            <list string="Accreditation Fees" editable="bottom" sample="1"
                  open_form_view="True"
                  default_order="receipt_date asc, id asc">
                <field name="currency_id" column_invisible="True"/>
                <field name="fee_type"/>
                <field name="receipt_number"/>
                <field name="receipt_date" width="130px"/>
                <!-- No column sum: the footer below already gives the two
                     figures that mean something here - what is still awaiting
                     confirmation and what is confirmed - and each of those
                     carries its own label, which a list aggregate does not. -->
                <field name="amount" widget="monetary"/>
                <!-- The upload widget belongs on the form; here the count says
                     whether the receipt is on file and the row expander opens
                     the scan. -->
                <field name="attachment_count" string="Scans" width="80px"/>
                <field name="notes" optional="hide"/>
                <field name="confirmed_by" optional="hide"/>
                <field name="confirmed_on" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-warning="state == 'draft'"/>
                <button name="action_confirm" type="object" string="Confirm"
                        icon="fa-check" title="Confirm the reception of the fee"
                        invisible="state == 'confirmed'"
                        groups="dma_accreditation.group_dma_finance"/>
                <button name="action_reset_draft" type="object" string="Reset"
                        icon="fa-undo" title="Reset the fee to draft"
                        invisible="state != 'confirmed'"
                        groups="dma_accreditation.group_dma_manager"/>
            </list>
        </field>
    </record>

    <!-- The standalone Fees screen. A separate view because the request is the
         one thing an officer needs here and must never be edited inline. -->
    <record id="dma_fee_payment_view_list_standalone" model="ir.ui.view">
        <field name="name">dma.fee.payment.list.standalone</field>
        <field name="model">dma.fee.payment</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Accreditation Fees" create="false" sample="1"
                  default_order="receipt_date desc, id desc">
                <!-- The screen exists to confirm a batch of receipts against a
                     batch of fees; one button per row made that a row-at-a-time
                     job. action_confirm already iterates its recordset. -->
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            groups="dma_accreditation.group_dma_finance"/>
                </header>
                <field name="currency_id" column_invisible="True"/>
                <field name="request_id" string="Request"/>
                <field name="partner_id" string="Applicant" optional="show"/>
                <field name="fee_type"/>
                <field name="receipt_number"/>
                <field name="receipt_date"/>
                <field name="amount" widget="monetary" sum="Total"/>
                <!-- Finance confirms a fee against its receipt, so the screen
                     where that happens has to say whether a scan is on file. -->
                <field name="attachment_count" string="Scans" width="80px"/>
                <field name="request_state" string="File Status" optional="hide"/>
                <field name="confirmed_by" optional="hide"/>
                <field name="confirmed_on" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-warning="state == 'draft'"/>
                <button name="action_confirm" type="object" string="Confirm"
                        icon="fa-check" title="Confirm the reception of the fee"
                        invisible="state == 'confirmed'"
                        groups="dma_accreditation.group_dma_finance"/>
            </list>
        </field>
    </record>

    <record id="dma_fee_payment_view_form" model="ir.ui.view">
        <field name="name">dma.fee.payment.form</field>
        <field name="model">dma.fee.payment</field>
        <field name="arch" type="xml">
            <form string="Accreditation Fee">
                <header>
                    <button name="action_confirm" type="object" string="Confirm Fee"
                            class="btn-primary" invisible="state == 'confirmed'"
                            groups="dma_accreditation.group_dma_finance"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state != 'confirmed'"
                            groups="dma_accreditation.group_dma_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <!-- The three things Confirm refuses without, said on the
                     screen instead of in a modal one blocker at a time. -->
                <div class="alert alert-warning" role="alert"
                     invisible="state == 'confirmed' or (receipt_number and receipt_date and amount &gt; 0)">
                    <b>Not ready to confirm.</b>
                    A receipt number, a receipt date and a non-zero amount are required before
                    the Finance Department can confirm this fee.
                </div>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Accreditation fee</span>
                        <h1><field name="fee_type" readonly="state == 'confirmed'"/></h1>
                        <div class="text-muted" invisible="not request_id">
                            <field name="request_id" nolabel="1" readonly="1" class="oe_inline"/>
                        </div>
                    </div>
                    <group>
                        <group string="Accreditation File">
                            <field name="partner_id" readonly="1"/>
                            <field name="request_state" readonly="1"/>
                        </group>
                        <group string="Receipt">
                            <!-- The monetary widget prints a bare number when
                                 currency_id is not in the arch, and the visible
                                 copy is stripped for every single-currency
                                 user, so the technical copy is unconditional. -->
                            <field name="currency_id" invisible="1"
                                   groups="!base.group_multi_currency"/>
                            <label for="amount"/>
                            <div name="amount_div" class="o_row">
                                <field name="amount" readonly="state == 'confirmed'"/>
                                <field name="currency_id" groups="base.group_multi_currency"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </div>
                            <field name="receipt_number" readonly="state == 'confirmed'"
                                   placeholder="e.g. REC/2026/0141"/>
                            <field name="receipt_date" readonly="state == 'confirmed'"/>
                        </group>
                    </group>
                    <!-- A record of something that happened, so it appears only
                         once it has, as one line rather than two blank rows. -->
                    <div class="text-muted mb-3" invisible="state != 'confirmed'">
                        <i class="fa fa-check text-success me-1" role="img" aria-hidden="true"/>
                        <field name="confirmed_label" nolabel="1" readonly="1" class="oe_inline"/>
                    </div>
                    <separator string="Receipt Scan"/>
                    <div class="text-muted small mb-1" invisible="attachment_ids">
                        No scan of the receipt has been attached yet.
                    </div>
                    <field name="attachment_ids" widget="many2many_binary" nolabel="1" class="w-100"/>
                    <separator string="Notes"/>
                    <field name="notes" nolabel="1" rows="3"
                           placeholder="Anything the Finance Department should record about this payment."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dma_fee_payment_view_search" model="ir.ui.view">
        <field name="name">dma.fee.payment.search</field>
        <field name="model">dma.fee.payment</field>
        <field name="arch" type="xml">
            <search string="Accreditation Fees">
                <field name="request_id"/>
                <field name="partner_id"/>
                <field name="receipt_number"/>
                <filter name="filter_draft" string="To Confirm" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="filter_sop" string="SOP Reading Fee" domain="[('fee_type', '=', 'sop_reading')]"/>
                <filter name="filter_demo" string="Demonstration Fee" domain="[('fee_type', '=', 'operational_demo')]"/>
                <separator/>
                <!-- Odoo's own period control: this year, this quarter,
                     last month and their comparisons, instead of one
                     hand-rolled year filter. -->
                <filter name="filter_receipt_date" string="Receipt Date" date="receipt_date"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_fee_type" string="Fee Type" context="{'group_by': 'fee_type'}"/>
                    <filter name="group_request" string="Request" context="{'group_by': 'request_id'}"/>
                    <filter name="group_partner" string="Applicant" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_receipt_month" string="Receipt Month"
                            context="{'group_by': 'receipt_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dma_fee_payment" model="ir.actions.act_window">
        <field name="name">Accreditation Fees</field>
        <field name="res_model">dma.fee.payment</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="dma_fee_payment_view_list_standalone"/>
        <field name="search_view_id" ref="dma_fee_payment_view_search"/>
        <!-- Explicitly empty rather than absent: removing the element would
             leave whatever an earlier version wrote in the database, and this
             screen used to land on a collapsed group-by that hid every row. -->
        <!-- A worklist first: the screen opens on the fees Finance still has
             to confirm, and one click on the filter shows the whole register.
             Explicitly set rather than absent, because removing the element
             would leave whatever an earlier version wrote in the database, and
             this screen used to land on a collapsed group-by that hid every
             row. -->
        <field name="context">{'search_default_filter_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                Nothing left to confirm.
            </p><p>
                Fees are raised from the accreditation file itself, on its
                <b>Fees</b> tab: the SOP reading fee during the SOP step, and the
                operational demonstration fee before the Accreditation Committee.
                They show up here for the Finance Department to confirm against
                the receipts.
            </p>
        </field>
    </record>

</odoo>
