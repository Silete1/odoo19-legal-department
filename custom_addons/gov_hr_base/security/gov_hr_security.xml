<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_gov_hr" model="ir.module.category">
        <field name="name">Government HR Administration</field>
        <field name="sequence">32</field>
    </record>

    <record id="privilege_gov_hr" model="res.groups.privilege">
        <field name="name">Government HR Roles</field>
        <field name="category_id" ref="module_category_gov_hr"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_gov_hr_user" model="res.groups">
        <field name="name">Government HR Request User</field>
        <field name="privilege_id" ref="privilege_gov_hr"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Create and follow government HR administrative requests.</field>
    </record>
    <record id="group_gov_hr_admin_officer" model="res.groups">
        <field name="name">Administrative Officer</field>
        <field name="privilege_id" ref="privilege_gov_hr"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_gov_hr_user'))]"/>
    </record>
    <record id="group_gov_hr_admin_manager" model="res.groups">
        <field name="name">Administrative Department Manager</field>
        <field name="privilege_id" ref="privilege_gov_hr"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('group_gov_hr_user'))]"/>
    </record>
    <record id="group_gov_hr_director_general" model="res.groups">
        <field name="name">Director General</field>
        <field name="privilege_id" ref="privilege_gov_hr"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_gov_hr_manager" model="res.groups">
        <field name="name">Government HR Configuration Manager</field>
        <field name="privilege_id" ref="privilege_gov_hr"/>
        <field name="sequence">50</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_gov_hr_case_company" model="ir.rule">
            <field name="name">Government HR case multi-company</field>
            <field name="model_id" ref="model_gov_hr_case"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_gov_hr_case_internal_relevant" model="ir.rule">
            <field name="name">Government HR relevant cases</field>
            <field name="model_id" ref="model_gov_hr_case"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|','|','|','|',
                ('requester_user_id', '=', user.id),
                ('department_id.manager_id.user_id', '=', user.id),
                ('current_approver_user_id', '=', user.id),
                ('administrative_officer_user_id', '=', user.id),
                '&amp;', ('participant_user_ids', 'in', [user.id]), ('state', '=', 'done')
            ]</field>
        </record>
        <record id="rule_gov_hr_case_admin_officer" model="ir.rule">
            <field name="name">Administrative officer assigned and processing cases</field>
            <field name="model_id" ref="model_gov_hr_case"/>
            <field name="groups" eval="[(4, ref('group_gov_hr_admin_officer'))]"/>
            <field name="domain_force">['|', ('administrative_officer_user_id', '=', user.id), ('state', 'in', ['document_review', 'mission_preparation', 'final_approvals', 'awaiting_outgoing', 'done'])]</field>
        </record>
        <record id="rule_gov_hr_case_admin_manager" model="ir.rule">
            <field name="name">Administrative manager company cases</field>
            <field name="model_id" ref="model_gov_hr_case"/>
            <field name="groups" eval="[(4, ref('group_gov_hr_admin_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_gov_hr_case_director" model="ir.rule">
            <field name="name">Director General company cases</field>
            <field name="model_id" ref="model_gov_hr_case"/>
            <field name="groups" eval="[(4, ref('group_gov_hr_director_general'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_create" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_gov_hr_case_manager" model="ir.rule">
            <field name="name">Government HR manager company cases</field>
            <field name="model_id" ref="model_gov_hr_case"/>
            <field name="groups" eval="[(4, ref('group_gov_hr_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_gov_hr_log_company" model="ir.rule">
            <field name="name">Government HR log multi-company</field>
            <field name="model_id" ref="model_gov_hr_approval_log"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_gov_hr_log_relevant" model="ir.rule">
            <field name="name">Government HR relevant approval logs</field>
            <field name="model_id" ref="model_gov_hr_approval_log"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|','|','|','|',
                ('case_id.requester_user_id', '=', user.id),
                ('case_id.department_id.manager_id.user_id', '=', user.id),
                ('case_id.current_approver_user_id', '=', user.id),
                ('case_id.administrative_officer_user_id', '=', user.id),
                '&amp;', ('case_id.participant_user_ids', 'in', [user.id]), ('case_id.state', '=', 'done')
            ]</field>
        </record>
        <record id="rule_gov_hr_log_management" model="ir.rule">
            <field name="name">Government HR management approval logs</field>
            <field name="model_id" ref="model_gov_hr_approval_log"/>
            <field name="groups" eval="[(4, ref('group_gov_hr_admin_manager')), (4, ref('group_gov_hr_director_general')), (4, ref('group_gov_hr_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_gov_hr_basis_company" model="ir.rule">
            <field name="name">Government HR supporting document multi-company</field>
            <field name="model_id" ref="model_gov_hr_case_basis"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_gov_hr_basis_relevant" model="ir.rule">
            <field name="name">Government HR relevant supporting documents</field>
            <field name="model_id" ref="model_gov_hr_case_basis"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|','|','|','|',
                ('case_id.requester_user_id', '=', user.id),
                ('case_id.department_id.manager_id.user_id', '=', user.id),
                ('case_id.current_approver_user_id', '=', user.id),
                ('case_id.administrative_officer_user_id', '=', user.id),
                '&amp;', ('case_id.participant_user_ids', 'in', [user.id]), ('case_id.state', '=', 'done')
            ]</field>
        </record>
        <record id="rule_gov_hr_basis_management" model="ir.rule">
            <field name="name">Government HR management supporting documents</field>
            <field name="model_id" ref="model_gov_hr_case_basis"/>
            <field name="groups" eval="[(4, ref('group_gov_hr_admin_manager')), (4, ref('group_gov_hr_director_general')), (4, ref('group_gov_hr_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_gov_hr_route_company" model="ir.rule">
            <field name="name">Government HR route company</field>
            <field name="model_id" ref="model_gov_hr_approval_route"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_gov_hr_step_company" model="ir.rule">
            <field name="name">Government HR step company</field>
            <field name="model_id" ref="model_gov_hr_approval_step"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_gov_hr_basis_type_company" model="ir.rule">
            <field name="name">Government HR basis type company</field>
            <field name="model_id" ref="model_gov_hr_basis_type"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_gov_hr_sequence_manager" model="ir.rule">
            <field name="name">Government HR sequences only</field>
            <field name="model_id" ref="base.model_ir_sequence"/>
            <field name="groups" eval="[(4, ref('group_gov_hr_manager'))]"/>
            <field name="domain_force">[('code', '=like', 'gov.hr.%')]</field>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
