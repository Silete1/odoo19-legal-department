<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_deputation_company" model="ir.rule">
            <field name="name">Deputation multi-company</field>
            <field name="model_id" ref="model_gov_hr_deputation"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_deputation_relevant" model="ir.rule">
            <field name="name">Relevant deputations</field>
            <field name="model_id" ref="model_gov_hr_deputation"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|','|','|','|',
                ('requester_user_id', '=', user.id),
                ('department_id.manager_id.user_id', '=', user.id),
                ('current_approver_user_id', '=', user.id),
                ('administrative_officer_user_id', '=', user.id),
                '&amp;', ('participant_ids.employee_id.user_id', '=', user.id), ('state', '=', 'done')
            ]</field>
        </record>
        <record id="rule_deputation_admin_officer" model="ir.rule">
            <field name="name">Administrative officer deputations</field>
            <field name="model_id" ref="model_gov_hr_deputation"/>
            <field name="groups" eval="[(4, ref('gov_hr_base.group_gov_hr_admin_officer'))]"/>
            <field name="domain_force">['|', ('administrative_officer_user_id', '=', user.id), ('state', 'in', ['document_review', 'mission_preparation', 'final_approvals', 'awaiting_outgoing', 'done'])]</field>
        </record>
        <record id="rule_deputation_admin_manager" model="ir.rule">
            <field name="name">Administrative manager deputations</field>
            <field name="model_id" ref="model_gov_hr_deputation"/>
            <field name="groups" eval="[(4, ref('gov_hr_base.group_gov_hr_admin_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_deputation_director" model="ir.rule">
            <field name="name">Director General deputations</field>
            <field name="model_id" ref="model_gov_hr_deputation"/>
            <field name="groups" eval="[(4, ref('gov_hr_base.group_gov_hr_director_general'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_create" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_deputation_manager" model="ir.rule">
            <field name="name">Government HR manager deputations</field>
            <field name="model_id" ref="model_gov_hr_deputation"/>
            <field name="groups" eval="[(4, ref('gov_hr_base.group_gov_hr_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_deputation_participant_company" model="ir.rule">
            <field name="name">Deputation participant multi-company</field>
            <field name="model_id" ref="model_gov_hr_deputation_participant"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_deputation_participant_relevant" model="ir.rule">
            <field name="name">Relevant deputation participants</field>
            <field name="model_id" ref="model_gov_hr_deputation_participant"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|','|','|','|',
                ('deputation_id.requester_user_id', '=', user.id),
                ('deputation_id.department_id.manager_id.user_id', '=', user.id),
                ('deputation_id.current_approver_user_id', '=', user.id),
                ('deputation_id.administrative_officer_user_id', '=', user.id),
                '&amp;', ('employee_id.user_id', '=', user.id), ('deputation_id.state', '=', 'done')
            ]</field>
        </record>
        <record id="rule_deputation_participant_management" model="ir.rule">
            <field name="name">Management deputation participants</field>
            <field name="model_id" ref="model_gov_hr_deputation_participant"/>
            <field name="groups" eval="[(4, ref('gov_hr_base.group_gov_hr_admin_officer')), (4, ref('gov_hr_base.group_gov_hr_admin_manager')), (4, ref('gov_hr_base.group_gov_hr_director_general')), (4, ref('gov_hr_base.group_gov_hr_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_deputation_activity_type_company" model="ir.rule">
            <field name="name">Deputation activity type company</field>
            <field name="model_id" ref="model_gov_hr_deputation_activity_type"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
