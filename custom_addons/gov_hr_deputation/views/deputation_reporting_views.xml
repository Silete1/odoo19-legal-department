<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gov_hr_deputation_pivot" model="ir.ui.view">
        <field name="name">gov.hr.deputation.pivot</field>
        <field name="model">gov.hr.deputation</field>
        <field name="arch" type="xml">
            <pivot string="Deputation Analysis" sample="1">
                <field name="department_id" type="row"/>
                <field name="date_from" interval="month" type="col"/>
                <field name="participant_count" type="measure"/>
                <field name="duration_days" type="measure"/>
                <field name="average_duration_days" type="measure"/>
                <field name="processing_duration_hours" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_gov_hr_deputation_graph" model="ir.ui.view">
        <field name="name">gov.hr.deputation.graph</field>
        <field name="model">gov.hr.deputation</field>
        <field name="arch" type="xml">
            <graph string="Deputation Analysis" sample="1">
                <field name="department_id"/>
                <field name="participant_count" type="measure"/>
                <field name="duration_days" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_gov_hr_deputation_register_list" model="ir.ui.view">
        <field name="name">gov.hr.deputation.register.list</field>
        <field name="model">gov.hr.deputation</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list string="Government Deputation Register" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="outgoing_number"/>
                <field name="outgoing_date"/>
                <field name="subject"/>
                <field name="department_id"/>
                <field name="destination"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="duration_days"/>
                <field name="participant_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="action_gov_hr_deputation_analysis" model="ir.actions.act_window">
        <field name="name">Deputation Analysis</field>
        <field name="res_model">gov.hr.deputation</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_gov_hr_deputation_search"/>
        <field name="context">{'search_default_this_year': 1}</field>
    </record>
    <record id="action_gov_hr_deputation_register" model="ir.actions.act_window">
        <field name="name">Government Deputation Register</field>
        <field name="res_model">gov.hr.deputation</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_gov_hr_deputation_register_list"/>
        <field name="search_view_id" ref="view_gov_hr_deputation_search"/>
    </record>

    <record id="view_gov_hr_deputation_activity_type_list" model="ir.ui.view">
        <field name="name">gov.hr.deputation.activity.type.list</field>
        <field name="model">gov.hr.deputation.activity.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_gov_hr_deputation_activity_types" model="ir.actions.act_window">
        <field name="name">Deputation Activity Types</field>
        <field name="res_model">gov.hr.deputation.activity.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
