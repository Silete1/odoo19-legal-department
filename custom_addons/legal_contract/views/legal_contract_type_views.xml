<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Contract Type -->
    <!-- ============================================================ -->
    <record id="view_legal_contract_type_list" model="ir.ui.view">
        <field name="name">legal.contract.type.list</field>
        <field name="model">legal.contract.type</field>
        <field name="arch" type="xml">
            <list string="Contract Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="default_review_group"/>
                <field name="default_notice_days" optional="hide"/>
                <field name="default_auto_renew" optional="hide"/>
                <field name="contract_count" string="Contracts"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_legal_contract_type_form" model="ir.ui.view">
        <field name="name">legal.contract.type.form</field>
        <field name="model">legal.contract.type</field>
        <field name="arch" type="xml">
            <form string="Contract Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_contracts" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="contract_count" widget="statinfo" string="Contracts"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Service Agreement"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="SERVICE"/>
                            <field name="default_review_group"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="default_notice_days"/>
                            <field name="default_auto_renew"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes on how this type is handled."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_legal_contract_type" model="ir.actions.act_window">
        <field name="name">Contract Types</field>
        <field name="res_model">legal.contract.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Configure a contract type</p>
            <p>
                A type carries what is true of every contract of its kind: which internal
                group reviews it and how far ahead its renewal is chased.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Responsible Department -->
    <!-- ============================================================ -->
    <record id="view_legal_contract_department_list" model="ir.ui.view">
        <field name="name">legal.contract.department.list</field>
        <field name="model">legal.contract.department</field>
        <field name="arch" type="xml">
            <list string="Departments" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_legal_contract_department" model="ir.actions.act_window">
        <field name="name">Responsible Departments</field>
        <field name="res_model">legal.contract.department</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Add an owning department</p>
            <p>
                The internal units that own contracts. A small list of the legal
                department's own, so the HR application is never a prerequisite.
            </p>
        </field>
    </record>

</odoo>
