<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Multi-company. Configuration records with no company are shared;
            everything else is scoped the ordinary Odoo way.
        -->

        <record id="rule_legal_gov_body_company" model="ir.rule">
            <field name="name">Government body: own company or shared</field>
            <field name="model_id" ref="model_legal_gov_body"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_legal_document_type_company" model="ir.rule">
            <field name="name">Document type: own company or shared</field>
            <field name="model_id" ref="model_legal_document_type"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_legal_entity_company" model="ir.rule">
            <field name="name">Legal entity: own company</field>
            <field name="model_id" ref="model_legal_entity"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_legal_document_company" model="ir.rule">
            <field name="name">Document: own company</field>
            <field name="model_id" ref="model_legal_document"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!--
            Confidentiality. A legal department holds scanned passports, personal
            powers of attorney and privileged papers, so a confidential document
            is visible to the manager and to the officers of the body that issued
            it, and to nobody else. This is a real foreign key on the document, not
            a polymorphic reference: a record rule cannot traverse res_model /
            res_id to a parent, so a design that hung documents off a Reference
            field could not express confidentiality at all.
        -->
        <record id="rule_legal_document_confidential" model="ir.rule">
            <field name="name">Document: confidential ones are restricted</field>
            <field name="model_id" ref="model_legal_document"/>
            <field name="groups" eval="[(4, ref('group_legal_clerk')), (4, ref('group_legal_officer')), (4, ref('group_legal_approver'))]"/>
            <field name="domain_force">['|', ('confidential', '=', False), ('issuing_body_id.officer_ids', 'in', [user.id])]</field>
        </record>

        <record id="rule_legal_document_manager" model="ir.rule">
            <field name="name">Document: the legal manager sees everything</field>
            <field name="model_id" ref="model_legal_document"/>
            <field name="groups" eval="[(4, ref('group_legal_manager')), (4, ref('group_legal_auditor'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
