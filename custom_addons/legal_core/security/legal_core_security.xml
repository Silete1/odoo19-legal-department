<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Five groups, and never a sixth per government body.

        The temptation in a module like this is one group per ministry, so that
        the Tax officer sees Tax files. That fails immediately: installing a
        content pack would then create security objects, a customer with a body
        nobody anticipated would need a developer, and the matrix would grow
        without bound. Per-body visibility is data instead - the officers on
        legal.gov.body, traversed by a record rule - which a consultant sets from
        an ordinary form.

        The ladder is deliberately short. Clerk does the work, Officer owns a
        body's files, Approver signs, Manager configures, Auditor reads.

        Odoo 19 groups a set of related res.groups under a res.groups.privilege,
        which is itself attached to an ir.module.category; res.groups.category_id
        no longer exists.
    -->

    <record id="module_category_legal" model="ir.module.category">
        <field name="name">Legal Department</field>
        <field name="description">Government liaison, correspondence and statutory compliance.</field>
        <field name="sequence">40</field>
    </record>

    <record id="res_groups_privilege_legal" model="res.groups.privilege">
        <field name="name">Legal Department</field>
        <field name="description">What the user may do inside the legal department.</field>
        <field name="category_id" ref="module_category_legal"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_legal_clerk" model="res.groups">
        <field name="name">Clerk</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_legal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Registers incoming and outgoing letters, prepares files, uploads documents and pays fees. Sees the files of the bodies they follow.</field>
    </record>

    <record id="group_legal_officer" model="res.groups">
        <field name="name">Follow-up Officer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_legal"/>
        <field name="implied_ids" eval="[(4, ref('group_legal_clerk'))]"/>
        <field name="comment">Owns the relationship with one or more government bodies: moves their files, chases them, and records what the counter said.</field>
    </record>

    <record id="group_legal_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_legal"/>
        <field name="implied_ids" eval="[(4, ref('group_legal_officer'))]"/>
        <field name="comment">Approves a file before it leaves the company, and signs the official letter.</field>
    </record>

    <record id="group_legal_manager" model="res.groups">
        <field name="name">Legal Manager</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_legal"/>
        <field name="implied_ids" eval="[(4, ref('group_legal_approver'))]"/>
        <field name="comment">Configures bodies, procedures, document types, registers and service levels. Sees every file, including confidential ones.</field>
    </record>

    <record id="group_legal_auditor" model="res.groups">
        <field name="name">Auditor (read only)</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_legal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Reads everything and changes nothing. For the internal auditor, the Federal Board of Supreme Audit, or an external reviewer.</field>
    </record>

</odoo>
