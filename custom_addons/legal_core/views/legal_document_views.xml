<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_legal_document_list" model="ir.ui.view">
        <field name="name">legal.document.list</field>
        <field name="model">legal.document</field>
        <field name="arch" type="xml">
            <list string="Document Register"
                  decoration-danger="expiry_state == 'expired'"
                  decoration-warning="expiry_state == 'expiring'"
                  decoration-info="expiry_state == 'due_soon'"
                  decoration-muted="state != 'active'">
                <field name="name"/>
                <field name="document_type_id"/>
                <field name="number"/>
                <field name="grade_id" optional="show"/>
                <field name="entity_id" optional="show"/>
                <field name="partner_id" optional="hide"/>
                <field name="issuing_body_id"/>
                <field name="issue_date" optional="hide"/>
                <field name="expiry_date"/>
                <field name="start_by_date" string="Start Renewal By"/>
                <field name="days_to_expiry" string="Days Left"/>
                <field name="expiry_state" widget="badge"
                       decoration-success="expiry_state == 'valid'"
                       decoration-info="expiry_state == 'due_soon'"
                       decoration-warning="expiry_state == 'expiring'"
                       decoration-danger="expiry_state == 'expired'"/>
                <field name="state" optional="hide"/>
                <field name="confidential" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_legal_document_form" model="ir.ui.view">
        <field name="name">legal.document.form</field>
        <field name="model">legal.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="active,superseded"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Superseded" bg_color="text-bg-secondary"
                            invisible="state != 'superseded'"/>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger"
                            invisible="expiry_state != 'expired' or state != 'active'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="هوية غرفة تجارة بغداد 2026"/></h1>
                    </div>
                    <group>
                        <group string="What It Is">
                            <field name="document_type_id"/>
                            <field name="number"/>
                            <field name="grade_id" invisible="not grade_id and not document_type_id"/>
                            <field name="issuing_body_id"/>
                            <field name="entity_id"/>
                            <field name="partner_id"/>
                            <field name="confidential"/>
                        </group>
                        <group string="Validity">
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="notice_days"/>
                            <field name="renewal_lead_days"/>
                            <field name="start_by_date" readonly="1"/>
                            <field name="days_to_expiry" readonly="1"/>
                            <field name="expiry_state" readonly="1" widget="badge"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="expiry_state not in ('due_soon', 'expiring')">
                        The renewal of this document takes roughly
                        <field name="renewal_lead_days" readonly="1" class="oe_inline"/> days at the
                        body, so it should be started by
                        <field name="start_by_date" readonly="1" class="oe_inline"/>.
                    </div>
                    <notebook>
                        <page string="Scans" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="History" name="history">
                            <group>
                                <field name="supersedes_id" readonly="1"/>
                                <field name="superseded_by_id" readonly="1"/>
                                <field name="replacement_reason"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                A renewal never edits the document it renews. It creates a new record
                                that supersedes the old one, and the old one stays - expired - with the
                                letters that were sent under it. That is the only way to answer
                                "what were we operating under in March".
                            </div>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_legal_document_search" model="ir.ui.view">
        <field name="name">legal.document.search</field>
        <field name="model">legal.document</field>
        <field name="arch" type="xml">
            <search string="Documents">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('number', 'ilike', self)]"/>
                <field name="document_type_id"/>
                <field name="issuing_body_id"/>
                <field name="entity_id"/>
                <field name="partner_id"/>
                <filter name="current" string="In Force" domain="[('is_current', '=', True)]"/>
                <separator/>
                <filter name="start_now" string="Renewal Should Have Started"
                        domain="[('expiry_state', 'in', ['due_soon', 'expiring', 'expired'])]"/>
                <filter name="expiring_30" string="Expiring Within 30 Days"
                        domain="[('expiry_state', '!=', 'no_expiry'), ('days_to_expiry', '&lt;=', 30), ('days_to_expiry', '&gt;=', 0)]"/>
                <filter name="expired" string="Expired" domain="[('expiry_state', '=', 'expired')]"/>
                <separator/>
                <filter name="confidential" string="Confidential" domain="[('confidential', '=', True)]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'document_type_id'}"/>
                    <filter name="group_body" string="Issuing Body" context="{'group_by': 'issuing_body_id'}"/>
                    <filter name="group_entity" string="Legal Entity" context="{'group_by': 'entity_id'}"/>
                    <filter name="group_state" string="Validity" context="{'group_by': 'expiry_state'}"/>
                    <filter name="group_expiry" string="Expiry Month" context="{'group_by': 'expiry_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_legal_document_calendar" model="ir.ui.view">
        <field name="name">legal.document.calendar</field>
        <field name="model">legal.document</field>
        <field name="arch" type="xml">
            <calendar string="Renewals" date_start="start_by_date" color="issuing_body_id" mode="month"
                      quick_create="0">
                <field name="name"/>
                <field name="document_type_id"/>
                <field name="issuing_body_id" filters="1"/>
                <field name="expiry_date"/>
            </calendar>
        </field>
    </record>

    <record id="action_legal_document" model="ir.actions.act_window">
        <field name="name">Document Register</field>
        <field name="res_model">legal.document</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_current': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">The company's papers, in one place</p>
            <p>
                Every dated artefact the company owns: the certificate of incorporation, the
                tax card, the Chamber identity with its class, the municipal licence, a
                residency. One register rather than a copy per file, so an expiring licence
                raises one alert rather than one per open case.
            </p>
        </field>
    </record>

    <record id="action_legal_document_renewals" model="ir.actions.act_window">
        <field name="name">Renewals Due</field>
        <field name="res_model">legal.document</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="domain">[('is_current', '=', True), ('expiry_state', 'in', ['due_soon', 'expiring', 'expired'])]</field>
        <field name="context">{'search_default_group_body': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Nothing needs renewing yet</p>
            <p>
                This board buckets on the date the renewal must <b>start</b>, not the date the
                document expires. "You should have started last Tuesday" is something a clerk
                can act on; "expires in sixty days" is decoration.
            </p>
        </field>
    </record>

</odoo>
