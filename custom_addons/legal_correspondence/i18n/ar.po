#: code:addons/legal_correspondence/wizard/legal_contact_note_wizard.py:0
msgid ""
"'%s' is not a contact note, so recording it here would take a register "
"number for a telephone call."
msgstr ""
"'%s' ليس تدوين اتصال، وتسجيله هنا يعني منح رقم من السجل لمكالمة هاتفية."

