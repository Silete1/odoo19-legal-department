<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            One group, and it is not a rank.

            مسؤول السجل is a *job*, not a level of seniority: in an Iraqi
            department one named person holds the book and allocates numbers, and
            everybody else - including officers senior to him - asks him for a
            number. So this group sits beside the ladder rather than inside it,
            and a register points at it through legal.register.write_group_id.

            A department that does not work that way leaves write_group_id empty
            on its books and nothing changes. That is why the shipped registers
            leave it empty: the restriction is a choice the customer makes, not
            one the module imposes on an install.

            The legal manager implies it, because somebody must be able to
            register a letter on the day the registrar is at a funeral.
        -->

        <record id="group_legal_registrar" model="res.groups">
            <field name="name">Registrar (مسؤول السجل)</field>
            <field name="sequence">25</field>
            <field name="privilege_id" ref="legal_core.res_groups_privilege_legal"/>
            <field name="implied_ids" eval="[(4, ref('legal_core.group_legal_clerk'))]"/>
            <field name="comment">Holds the correspondence register and allocates its numbers. A job, not a rank: point a register's Registrar Group at this to stop anybody else taking a number out of that book.</field>
        </record>

        <record id="legal_core.group_legal_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_legal_registrar'))]"/>
        </record>

    </data>
</odoo>
