<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_legal_correspondence_list" model="ir.ui.view">
        <field name="name">legal.correspondence.list</field>
        <field name="model">legal.correspondence</field>
        <field name="arch" type="xml">
            <list string="Correspondence Register"
                  decoration-muted="state == 'void'"
                  decoration-info="state == 'draft'"
                  decoration-danger="reply_state == 'late'"
                  decoration-bf="reply_state == 'late'">
                <field name="our_number" string="Our Number"/>
                <field name="our_date" string="Date"/>
                <field name="direction" optional="show"/>
                <field name="kind_id"/>
                <field name="gov_body_id"/>
                <field name="body_section" optional="hide"/>
                <field name="referred_to_body_id" optional="hide"/>
                <field name="subject"/>
                <field name="their_number" optional="show" string="Their Number"/>
                <field name="their_date" optional="hide"/>
                <field name="entity_id" optional="hide"/>
                <field name="carried_by_id" optional="hide"/>
                <field name="round" optional="hide"/>
                <field name="reply_due_on" optional="show"/>
                <field name="reply_state" widget="badge" optional="show"
                       decoration-success="reply_state == 'answered'"
                       decoration-warning="reply_state == 'awaiting'"
                       decoration-danger="reply_state == 'late'"/>
                <field name="secrecy" optional="hide" widget="badge"
                       decoration-danger="secrecy == 'secret'"/>
                <field name="state" widget="badge" optional="show"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'registered'"
                       decoration-danger="state == 'void'"/>
                <field name="register_id" optional="hide"/>
                <field name="user_id" optional="hide" widget="many2one_avatar_user"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_legal_correspondence_form" model="ir.ui.view">
        <field name="name">legal.correspondence.form</field>
        <field name="model">legal.correspondence</field>
        <field name="arch" type="xml">
            <form string="Correspondence">
                <header>
                    <button name="action_register" type="object" string="Register"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_print_letter" type="object" string="Print Letter"
                            class="btn-primary"
                            invisible="state != 'registered' or direction == 'in' or is_contact_note"/>
                    <button name="action_open_contact_note" type="object" string="Record Contact Note"
                            class="btn-secondary" invisible="state != 'registered'"/>
                    <button name="action_reply" type="object" string="Next In Thread"
                            class="btn-secondary" invisible="state != 'registered'"/>
                    <button name="action_void" type="object" string="Void"
                            class="btn-secondary" invisible="state != 'registered'"
                            groups="legal_core.group_legal_officer"/>
                    <button name="action_snapshot_pdf" type="object" string="Attach Filed PDF"
                            class="btn-secondary"
                            invisible="state != 'registered' or direction == 'in' or is_contact_note"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,registered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_thread" type="object" class="oe_stat_button" icon="fa-comments-o">
                            <field name="thread_count" widget="statinfo" string="In Thread"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Void" bg_color="text-bg-danger"
                            invisible="state != 'void'"/>
                    <widget name="web_ribbon" title="Confidential" bg_color="text-bg-warning"
                            invisible="secrecy != 'secret' or state == 'void'"/>
                    <field name="is_contact_note" invisible="1"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="subject" string="Subject"/>
                        <h1><field name="subject" placeholder="Request for a tax clearance certificate"/></h1>
                    </div>
                    <group>
                        <group string="Our Register">
                            <field name="kind_id"/>
                            <field name="register_id" readonly="state != 'draft'"
                                   invisible="is_contact_note" required="not is_contact_note"/>
                            <field name="our_number" readonly="state != 'draft'"
                                   invisible="is_contact_note" placeholder="Allocated at registration"/>
                            <field name="our_date" readonly="state != 'draft'"/>
                            <field name="direction" readonly="state != 'draft'"
                                   invisible="is_contact_note"/>
                            <field name="secrecy"/>
                        </group>
                        <group string="Their Reference" invisible="is_contact_note">
                            <field name="their_number" placeholder="e.g. K/M/1234"/>
                            <field name="their_date"/>
                            <field name="body_reference" placeholder="Their internal file number"/>
                            <field name="reply_to_id"/>
                            <field name="round"/>
                        </group>
                    </group>
                    <group>
                        <group string="The Body">
                            <field name="gov_body_id"/>
                            <field name="body_section"/>
                            <field name="entity_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Hand-off">
                            <field name="referred_to_body_id"/>
                            <field name="referral_date" invisible="not referred_to_body_id"
                                   required="referred_to_body_id"/>
                            <field name="document_action"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="not referred_to_body_id">
                        The file has been handed on. A referral is an edge between two bodies, so
                        the reply clock and every chase from here belong to
                        <field name="referred_to_body_id" readonly="1" class="oe_inline"/> - not to
                        the body that received the letter first.
                    </div>
                    <notebook>
                        <page string="The Letter" name="letter" invisible="is_contact_note">
                            <group>
                                <group>
                                    <field name="letter_template_id"/>
                                    <field name="signatory_id"/>
                                </group>
                                <group>
                                    <field name="outbound_method" invisible="direction == 'in'"/>
                                    <field name="carried_by_id"
                                           invisible="outbound_method != 'hand_carried' or direction == 'in'"/>
                                    <field name="channel"/>
                                    <field name="portal_ref" invisible="channel == 'paper'"/>
                                    <field name="portal_url" widget="url" invisible="channel == 'paper'"/>
                                </group>
                            </group>
                            <field name="body_html" placeholder="After greetings, ..."/>
                        </page>
                        <page string="Subject Table" name="lines" invisible="is_contact_note">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="reference"/>
                                    <field name="partner_id"/>
                                    <field name="note"/>
                                </list>
                            </field>
                            <div class="text-muted">
                                A letter that concerns eleven engineers is <b>one</b> letter with
                                eleven numbered rows, printed as the ت table - not eleven letters.
                            </div>
                        </page>
                        <page string="Contact Note" name="contact" invisible="not is_contact_note">
                            <group>
                                <field name="spoke_to" placeholder="Abu Ahmed - deputy head of the section"/>
                                <field name="promised_on"/>
                            </group>
                            <field name="said" placeholder="He said the file is with the legal adviser, and promised to look at it after Eid."/>
                            <div class="alert alert-info" role="alert">
                                This entry takes <b>no register number</b> - nothing entered the book.
                                A date in <b>Promised For</b> moves the reply clock onto it and suppresses
                                the next chase, so we stop ringing a body that has already answered.
                            </div>
                        </page>
                        <page string="Reply Clock" name="reply">
                            <group>
                                <group>
                                    <field name="reply_expected"/>
                                    <field name="reply_days" invisible="not reply_expected"/>
                                    <field name="reply_due_on" readonly="1"/>
                                    <field name="reply_state" readonly="1" widget="badge"/>
                                </group>
                                <group>
                                    <field name="is_substantive_reply" readonly="1"/>
                                </group>
                            </group>
                            <field name="answer_ids" readonly="1">
                                <list>
                                    <field name="our_date"/>
                                    <field name="kind_id"/>
                                    <field name="our_number"/>
                                    <field name="spoke_to"/>
                                    <field name="promised_on"/>
                                    <field name="subject"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Scans" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Filed Copy" name="snapshot"
                              invisible="not snapshot_html and not snapshot_attachment_id">
                            <group>
                                <field name="snapshot_attachment_id" readonly="1"/>
                                <field name="verification_token" readonly="1"/>
                            </group>
                            <field name="snapshot_html" readonly="1"/>
                            <div class="alert alert-info" role="alert">
                                This is the letter as it was rendered on the day it left. A reprint
                                returns this rather than a re-render against today's template,
                                because the template will have changed and the copy in the
                                ministry's file will not have.
                            </div>
                        </page>
                        <page string="Void" name="void" invisible="state != 'void'">
                            <group>
                                <field name="void_reason" readonly="1"/>
                            </group>
                            <div class="alert alert-warning" role="alert">
                                The number stays in the book. A voided entry keeps its place exactly
                                as a clerk keeps the page: the line is drawn, ملغى is written beside
                                it, and the next letter takes the next number. That is the only way
                                the register can answer "there is no 148 in your book - what
                                happened to it?".
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_legal_correspondence_search" model="ir.ui.view">
        <field name="name">legal.correspondence.search</field>
        <field name="model">legal.correspondence</field>
        <field name="arch" type="xml">
            <search string="Correspondence">
                <field name="subject" filter_domain="['|', '|', ('subject', 'ilike', self), ('our_number', 'ilike', self), ('their_number', 'ilike', self)]"
                       string="Number or Subject"/>
                <field name="gov_body_id"/>
                <field name="entity_id"/>
                <field name="register_id"/>
                <field name="kind_id"/>
                <field name="carried_by_id"/>
                <field name="spoke_to"/>
                <filter name="outgoing" string="Outgoing" domain="[('direction', '=', 'out')]"/>
                <filter name="incoming" string="Incoming" domain="[('direction', '=', 'in')]"/>
                <filter name="internal" string="Internal" domain="[('direction', '=', 'internal')]"/>
                <separator/>
                <filter name="registered" string="Registered" domain="[('state', '=', 'registered')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="void" string="Void" domain="[('state', '=', 'void')]"/>
                <separator/>
                <filter name="awaiting" string="Awaiting Reply" domain="[('reply_state', '=', 'awaiting')]"/>
                <filter name="late" string="Reply Overdue" domain="[('reply_state', '=', 'late')]"/>
                <filter name="answered" string="Answered" domain="[('reply_state', '=', 'answered')]"/>
                <separator/>
                <filter name="promised" string="Promised A Date" domain="[('promised_on', '!=', False)]"/>
                <filter name="contact_notes" string="Contact Notes" domain="[('is_contact_note', '=', True)]"/>
                <filter name="returns" string="Sent Back For Completion" domain="[('kind_id.is_return', '=', True)]"/>
                <separator/>
                <filter name="secret" string="Confidential" domain="[('secrecy', '=', 'secret')]"/>
                <filter name="mine" string="My Entries" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="this_year" string="This Year"
                        domain="[('our_date', '&gt;=', (context_today().replace(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_body" string="Body" context="{'group_by': 'gov_body_id'}"/>
                    <filter name="group_register" string="Register" context="{'group_by': 'register_id'}"/>
                    <filter name="group_kind" string="Kind" context="{'group_by': 'kind_id'}"/>
                    <filter name="group_direction" string="Direction" context="{'group_by': 'direction'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_entity" string="Legal Entity" context="{'group_by': 'entity_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'our_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_legal_correspondence_calendar" model="ir.ui.view">
        <field name="name">legal.correspondence.calendar</field>
        <field name="model">legal.correspondence</field>
        <field name="arch" type="xml">
            <calendar string="Register" date_start="our_date" color="gov_body_id" mode="month"
                      quick_create="0" event_open_popup="1">
                <field name="our_number"/>
                <field name="kind_id"/>
                <field name="gov_body_id" filters="1"/>
                <field name="subject"/>
                <field name="reply_due_on"/>
            </calendar>
        </field>
    </record>

    <record id="view_legal_correspondence_kanban" model="ir.ui.view">
        <field name="name">legal.correspondence.kanban</field>
        <field name="model">legal.correspondence</field>
        <field name="arch" type="xml">
            <kanban default_group_by="gov_body_id" quick_create="false">
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <strong><field name="our_number"/></strong>
                            <field name="our_date"/>
                        </div>
                        <div class="text-truncate"><field name="subject"/></div>
                        <div class="text-muted small"><field name="kind_id"/></div>
                        <div class="mt-1">
                            <field name="reply_state" widget="badge"
                                   decoration-success="reply_state == 'answered'"
                                   decoration-warning="reply_state == 'awaiting'"
                                   decoration-danger="reply_state == 'late'"/>
                            <field name="activity_ids" widget="kanban_activity"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!--
        The mail room is the landing screen, not a report. What arrived, what has
        not been answered and who promised what is the question the department
        opens the software to ask; a dashboard of counts is not.
    -->
    <record id="action_legal_correspondence_mail_room" model="ir.actions.act_window">
        <field name="name">Register Entries</field>
        <field name="res_model">legal.correspondence</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="context">{'search_default_registered': 1, 'search_default_group_body': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Nothing in the book yet</p>
            <p>
                Register the letter that arrived this morning. It does not need a file, a case
                or a procedure - an unprompted tax assessment arrives before anybody has opened
                one, and a register that refuses it until somebody does is a register that
                loses letters.
            </p>
        </field>
    </record>

    <record id="action_legal_correspondence_out" model="ir.actions.act_window">
        <field name="name">Outgoing</field>
        <field name="res_model">legal.correspondence</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="domain">[('direction', '=', 'out')]</field>
        <field name="context">{'search_default_registered': 1}</field>
    </record>

    <record id="action_legal_correspondence_in" model="ir.actions.act_window">
        <field name="name">Incoming</field>
        <field name="res_model">legal.correspondence</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="domain">[('direction', '=', 'in')]</field>
        <field name="context">{'search_default_registered': 1}</field>
    </record>

    <record id="action_legal_correspondence_awaiting" model="ir.actions.act_window">
        <field name="name">Awaiting Reply</field>
        <field name="res_model">legal.correspondence</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('reply_state', 'in', ['awaiting', 'late'])]</field>
        <field name="context">{'search_default_group_body': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Nobody owes us an answer</p>
            <p>
                Counted in the body's own working days, and moved by any promise recorded on the
                telephone. A chase list that fires on a counter which already answered is a
                chase list people switch off.
            </p>
        </field>
    </record>

    <record id="action_legal_contact_note_log" model="ir.actions.act_window">
        <field name="name">Contact Notes</field>
        <field name="res_model">legal.correspondence</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_contact_note', '=', True)]</field>
        <field name="context">{'search_default_group_body': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">No calls recorded</p>
            <p>
                An Iraqi file moves because somebody rang the section head, not because a letter
                was sent. None of that is correspondence - no number was taken - but all of it
                is evidence, and it is what tells the software to stop chasing.
            </p>
        </field>
    </record>

</odoo>
