<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ LIST -->
    <record id="view_legal_deadline_list" model="ir.ui.view">
        <field name="name">legal.deadline.list</field>
        <field name="model">legal.deadline</field>
        <field name="arch" type="xml">
            <list string="Deadlines" default_order="date_due asc"
                  create="false" edit="false" delete="false"
                  decoration-danger="state == 'overdue'">
                <field name="name"/>
                <field name="kind" widget="badge"/>
                <field name="date_due"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'overdue'"
                       decoration-info="state == 'open'"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="res_model" optional="hide"/>
                <field name="res_id" column_invisible="1"/>
                <button name="action_open_origin" type="object"
                        icon="fa-external-link" title="Open Source Record"/>
            </list>
        </field>
    </record>

    <!-- ======================================================== CALENDAR -->
    <record id="view_legal_deadline_calendar" model="ir.ui.view">
        <field name="name">legal.deadline.calendar</field>
        <field name="model">legal.deadline</field>
        <field name="arch" type="xml">
            <calendar string="Deadlines" date_start="date_due" mode="month"
                      color="kind" quick_create="0" event_open_popup="1">
                <field name="name"/>
                <field name="kind"/>
                <field name="user_id"/>
            </calendar>
        </field>
    </record>

    <!-- ========================================================== SEARCH -->
    <record id="view_legal_deadline_search" model="ir.ui.view">
        <field name="name">legal.deadline.search</field>
        <field name="model">legal.deadline</field>
        <field name="arch" type="xml">
            <search string="Deadlines">
                <field name="name"/>
                <field name="user_id"/>
                <field name="kind"/>
                <field name="res_model"/>
                <filter name="my_deadlines" string="My Deadlines"
                        domain="[('user_id', '=', uid)]"/>
                <filter name="overdue" string="Overdue"
                        domain="[('state', '=', 'overdue')]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('date_due', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="this_week" string="This Week"
                        domain="['&amp;', ('date_due', '&gt;=', context_today().strftime('%Y-%m-%d')), ('date_due', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="This Month"
                        domain="['&amp;', ('date_due', '&gt;=', context_today().strftime('%Y-%m-01')), ('date_due', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="hearings" string="Hearings"
                        domain="[('kind', '=', 'hearing')]"/>
                <filter name="obligations" string="Obligations"
                        domain="[('kind', 'in', ('obligation', 'contract_obligation'))]"/>
                <filter name="expiries" string="Expiries"
                        domain="[('kind', 'in', ('document_expiry', 'poa_expiry', 'contract_expiry'))]"/>
                <filter name="replies" string="Replies"
                        domain="[('kind', '=', 'correspondence_reply')]"/>
                <filter name="appeal_windows" string="Appeal Windows"
                        domain="[('kind', '=', 'appeal_window')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_kind" string="Kind"
                            context="{'group_by': 'kind'}"/>
                    <filter name="group_user" string="Responsible"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ========================================================== ACTION -->
    <record id="action_legal_deadline" model="ir.actions.act_window">
        <field name="name">Deadlines</field>
        <field name="res_model">legal.deadline</field>
        <field name="view_mode">list,calendar</field>
        <field name="search_view_id" ref="view_legal_deadline_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Nothing is due</p>
            <p>
                Every clock the legal department runs - court hearings, statutory
                filings, awaited replies, expiring documents and powers of attorney,
                appeal windows, contract and request deadlines - lands on this one
                board the moment it exists at its source. An empty board means the
                department is ahead of every date it knows about.
            </p>
        </field>
    </record>

    <!-- ============================================================ MENU -->
    <menuitem id="menu_legal_deadline"
              name="Deadlines"
              parent="legal_core.menu_legal_root"
              action="action_legal_deadline"
              sequence="35"/>

</odoo>
