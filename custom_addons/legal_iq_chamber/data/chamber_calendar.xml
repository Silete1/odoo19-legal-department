<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The body's own working time, which is what every clock in the product
        counts in.

        An Iraqi office works Sunday to Thursday. A target counted in calendar
        days is wrong twice a week and wrong for a week at each Eid, and a chase
        list that is wrong that often is a chase list people learn to ignore.
        legal.gov.body._plan_days walks this calendar, so "they have had it for
        six working days" means six days the counter was actually open.

        This file is generated, and every pack carries its own copy of the
        national closures on purpose: a customer must be able to install this
        pack without installing any of the others.

        The Islamic dates are ASTRONOMICAL ESTIMATES for 1447-1448 AH. Iraq
        announces عيد الفطر and عيد الأضحى by sighting, usually a day or two
        beforehand, and the announcement can move them by a day in either
        direction. They are here so the calendar is roughly right rather than
        obviously wrong, and they are meant to be corrected each year.
    -->
    <data noupdate="1">

        <record id="calendar_chamber" model="resource.calendar">
            <field name="name">دوام غرفة تجارة بغداد (الأحد - الخميس، والخميس حتى ١٣:٠٠)</field>
            <field name="tz">Asia/Baghdad</field>
            <field name="hours_per_day">5.8</field>
            <field name="attendance_ids" eval="[
                (5, 0, 0),
                (0, 0, {'name': 'الأحد', 'dayofweek': '6', 'hour_from': 8.0, 'hour_to': 14.0, 'day_period': 'full_day'}),
                (0, 0, {'name': 'الاثنين', 'dayofweek': '0', 'hour_from': 8.0, 'hour_to': 14.0, 'day_period': 'full_day'}),
                (0, 0, {'name': 'الثلاثاء', 'dayofweek': '1', 'hour_from': 8.0, 'hour_to': 14.0, 'day_period': 'full_day'}),
                (0, 0, {'name': 'الأربعاء', 'dayofweek': '2', 'hour_from': 8.0, 'hour_to': 14.0, 'day_period': 'full_day'}),
                (0, 0, {'name': 'الخميس', 'dayofweek': '3', 'hour_from': 8.0, 'hour_to': 13.0, 'day_period': 'full_day'}),
            ]"/>
        </record>

        <record id="leave_chamber_new_year_2026" model="resource.calendar.leaves">
            <field name="name">رأس السنة الميلادية</field>
            <field name="calendar_id" ref="calendar_chamber"/>
            <field name="date_from">2026-01-01 00:00:00</field>
            <field name="date_to">2026-01-01 23:59:59</field>
        </record>

