<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The Iraqi dinar, made the company currency and made to read the way an
        Iraqi office writes money: whole dinars, no fils (rounding 1 drives
        decimal_places to zero, so 750,000,000 prints as a round figure).

        These are <function> calls, not <record> overrides, for a reason: the
        target records belong to `base` and their ir.model.data rows are
        noupdate, so a <record id="base.IQD"> is silently skipped when this
        module is UPDATED rather than freshly installed - which is exactly when
        an existing database needs the fix. A write() runs on every upgrade and
        is idempotent.
    -->
    <data>
        <function model="res.currency" name="write">
            <value eval="[ref('base.IQD')]"/>
            <value eval="{'active': True, 'rounding': 1.0}"/>
        </function>
        <function model="res.company" name="write">
            <value eval="[ref('base.main_company')]"/>
            <value eval="{'currency_id': ref('base.IQD')}"/>
        </function>
    </data>
</odoo>
