<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The Iraqi dinar, made the company currency and made to read the way an
        Iraqi office writes money: whole dinars, no fils. ``rounding = 1`` drives
        ``decimal_places`` to zero, so 750,000,000 prints as a round figure rather
        than 750,000,000.000.

        This file is deliberately NOT noupdate: it must take effect on a plain
        ``-u legal_iq_demo`` of an already-installed database, unlike the rest of
        the demo pack whose records the engine and the register refuse to rewrite.
    -->
    <data>
        <record id="base.IQD" model="res.currency">
            <field name="active">True</field>
            <field name="rounding">1</field>
        </record>

        <record id="base.main_company" model="res.company">
            <field name="currency_id" ref="base.IQD"/>
        </record>
    </data>
</odoo>
