            <field name="jurisdiction_id" ref="legal_core.jurisdiction_iq_federal"/>
            <field name="letterhead_recipient">وزارة التجارة</field>
            <field name="channel">hybrid</field>
            <field name="portal_url">https://mot.gov.iq</field>
            <field name="resource_calendar_id" ref="calendar_mot_registrar"/>
            <field name="legal_basis">قانون الشركات رقم 21 لسنة 1997 المعدل</field>
            <field name="legal_basis_url">https://mot.gov.iq</field>
            <field name="last_verified_on">2026-08-30</field>
            <field name="verification_status">verified</field>
            <field name="sequence">10</field>
