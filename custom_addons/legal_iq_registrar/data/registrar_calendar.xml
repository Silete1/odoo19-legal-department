<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The Registrar's own working time, and why every pack ships one.

        Every deadline this product quotes is counted in the *body's* working
        days, through legal.gov.body._plan_days. An Iraqi office works Sunday to
        Thursday, so a target counted in calendar days cries wolf every Friday
        and Saturday, and a chase list that is wrong twice a week is a chase list
        people learn to ignore.

        The national closures are repeated in each content pack rather than
        shipped once from a shared base, because a customer must be able to take
        Tax without the Registrar. A leave row scoped to this calendar costs one
        record; a hidden cross-pack dependency costs a support call.

        The Islamic dates below are ASTRONOMICAL ESTIMATES for 1447-1448 AH.
        Iraq announces عيد الفطر and عيد الأضحى by sighting, usually a day or
        two before, and the announcement can move the date by one day in either
        direction. They are shipped so that the calendar is roughly right rather
        than obviously wrong, and they are meant to be corrected each year.
    -->
    <data noupdate="1">

        <record id="calendar_mot_registrar" model="resource.calendar">
            <field name="name">دوام دائرة تسجيل الشركات (الأحد - الخميس، ٠٨:٣٠ - ١٤:١٥)</field>
            <field name="tz">Asia/Baghdad</field>
            <field name="hours_per_day">5.75</field>
            <field name="attendance_ids" eval="[
                (5, 0, 0),
                (0, 0, {'name': 'الأحد', 'dayofweek': '6', 'hour_from': 8.5, 'hour_to': 14.25, 'day_period': 'full_day'}),
                (0, 0, {'name': 'الاثنين', 'dayofweek': '0', 'hour_from': 8.5, 'hour_to': 14.25, 'day_period': 'full_day'}),
                (0, 0, {'name': 'الثلاثاء', 'dayofweek': '1', 'hour_from': 8.5, 'hour_to': 14.25, 'day_period': 'full_day'}),
                (0, 0, {'name': 'الأربعاء', 'dayofweek': '2', 'hour_from': 8.5, 'hour_to': 14.25, 'day_period': 'full_day'}),
                (0, 0, {'name': 'الخميس', 'dayofweek': '3', 'hour_from': 8.5, 'hour_to': 14.25, 'day_period': 'full_day'}),
            ]"/>
        </record>

        <record id="leave_mot_new_year_2026" model="resource.calendar.leaves">
            <field name="name">رأس السنة الميلادية</field>
            <field name="calendar_id" ref="calendar_mot_registrar"/>
            <field name="date_from">2026-01-01 00:00:00</field>
            <field name="date_to">2026-01-01 23:59:59</field>
        </record>

