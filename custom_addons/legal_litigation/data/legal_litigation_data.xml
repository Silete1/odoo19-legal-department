<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            The case-number sequence. Shared (company_id False) so a group with
            more than one company still runs one continuous litigation register,
            which is how a legal department expects its own numbering to behave.
        -->
        <record id="seq_legal_lawsuit" model="ir.sequence">
            <field name="name">Lawsuit Reference</field>
            <field name="code">legal.lawsuit</field>
            <field name="prefix">LAW/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
