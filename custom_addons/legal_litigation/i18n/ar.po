#. module: legal_litigation
msgid "the advocate"
msgstr "المحامي"

#. module: legal_litigation
msgid ""
"“%(case)s” cannot be filed yet:\n"
"\n"
"%(reasons)s"
msgstr ""
"لا يمكن إقامة «%(case)s» بعد:\n"
"\n"
"%(reasons)s"

#. module: legal_litigation
msgid "“%s” is not at a point where a judgment can be challenged."
msgstr "«%s» ليست في مرحلة يمكن فيها الطعن في الحكم."

#. module: legal_litigation
msgid "“%s” is recorded as filed but carries no court case number."
msgstr "«%s» مقيدة على أنها مقامة لكنها بلا رقم دعوى لدى المحكمة."

#. module: legal_litigation
msgid ""
"“%s” is recorded as filed but has no court. A filed case is filed somewhere."
msgstr ""
"«%s» مقيدة على أنها مقامة لكن بلا محكمة، والدعوى المقامة تقام لدى محكمة."

#. module: legal_litigation
msgid "Preparation"
msgstr "التحضير"
