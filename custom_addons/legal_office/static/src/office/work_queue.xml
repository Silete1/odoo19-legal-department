<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="legal_office.LegalWorkQueue">
        <section class="o_legal_panel o_legal_queue">

            <header class="o_legal_panel__head">
                <h2 class="o_legal_panel__name" t-att-title="props.queue.hint"
                    t-esc="props.queue.title"/>
                <span class="o_legal_pill o_legal_num" dir="ltr"
                      t-if="props.queue.total" t-esc="props.queue.total"/>
            </header>

            <!-- Queue tabs. Compact text tabs with counts rather than filled
                 pills: they switch which register is in view and belong with
                 the list, not on top of it as a row of buttons. Drawn only
                 when the queue actually mixes registers - a single-source
                 queue with one tab beside "All" is a control that cannot
                 change anything. -->
            <div class="o_legal_qtabs" t-if="props.queue.scopes.length" role="tablist">
                <button type="button" role="tab"
                        t-foreach="props.queue.scopes" t-as="scope" t-key="scope.key"
                        t-attf-class="o_legal_qtab {{ isScope(scope.key) ? 'o_legal_qtab--on' : '' }}"
                        t-att-aria-selected="isScope(scope.key) ? 'true' : 'false'"
                        t-on-click="() => this.setScope(scope.key)">
                    <span class="o_legal_qtab__label" t-esc="scope.label"/>
                    <span class="o_legal_qtab__count o_legal_num" dir="ltr"
                          t-esc="scope.count_label"/>
                </button>
            </div>

            <!-- An empty queue is good news and is written as good news, in
                 two lines, inside the panel's normal padding. It does not get
                 an illustration and it does not get 300px of the screen. -->
            <div class="o_legal_blank" t-if="!rows.length">
                <i class="fa fa-check-circle" role="img" aria-hidden="true"/>
                <div>
                    <p class="o_legal_blank__title" t-esc="props.queue.empty.title"/>
                    <p class="o_legal_blank__hint" t-esc="props.queue.empty.hint"/>
                </div>
            </div>

            <div class="o_legal_queue__scroll" t-else="">
                <table class="o_legal_queue__table" t-ref="table"
                       t-on-keydown="onKeydown">
                    <thead>
                        <tr>
                            <th class="o_legal_col_kind" scope="col">
                                <span class="visually-hidden" t-esc="label.subject"/>
                            </th>
                            <th class="o_legal_col_ref" scope="col" t-esc="label.reference"/>
                            <th class="o_legal_col_subject" scope="col" t-esc="label.subject"/>
                            <th class="o_legal_col_state" scope="col" t-esc="label.state"/>
                            <th class="o_legal_col_why" scope="col" t-esc="label.why"/>
                            <th class="o_legal_col_due" scope="col" t-esc="label.due"/>
                        </tr>
                    </thead>

                    <!-- One tbody per focus band, so the band header sits in
                         the same column grid as its rows and the table keeps
                         its alignment. -->
                    <tbody t-foreach="bands" t-as="band" t-key="band.bucket">
                        <tr class="o_legal_band">
                            <th class="o_legal_band__head" colspan="6" scope="colgroup">
                                <span t-attf-class="o_legal_band__dot o_legal_tone--{{ band.tone }}"
                                      aria-hidden="true"/>
                                <span class="o_legal_band__label" t-esc="band.label"/>
                                <span class="o_legal_band__sep" aria-hidden="true">·</span>
                                <span class="o_legal_band__count o_legal_num" dir="ltr"
                                      t-esc="band.count"/>
                            </th>
                        </tr>

                        <tr t-foreach="band.rows" t-as="entry" t-key="entry.row.id"
                            tabindex="0"
                            t-attf-class="o_legal_queue__row {{ entry.row.priority > 1 ? 'o_legal_queue__row--urgent' : '' }}"
                            t-on-click="() => this.open(entry.row)"
                            t-on-focus="() => this.onRowFocus(entry.index)">

                            <td class="o_legal_col_kind">
                                <i t-attf-class="fa {{ entry.row.icon }}" role="img"
                                   t-att-title="entry.row.kind_label"
                                   t-att-aria-label="entry.row.kind_label"/>
                            </td>

                            <!-- References are quoted over the telephone and
                                 typed into search boxes, so they are pinned
                                 LTR and set in tabular figures whatever the
                                 page direction: the bidi algorithm otherwise
                                 renders 2026/0498/ق back to front. -->
                            <td class="o_legal_col_ref">
                                <span class="o_legal_ref o_legal_num" dir="ltr"
                                      t-att-title="entry.row.reference"
                                      t-esc="entry.row.reference"/>
                            </td>

                            <td class="o_legal_col_subject">
                                <span class="o_legal_subject" t-att-title="entry.row.subject"
                                      t-esc="entry.row.subject"/>
                                <span class="o_legal_owner" t-if="entry.row.owner"
                                      t-esc="entry.row.owner"/>
                            </td>

                            <!-- A dot and a word, not an outlined box. At
                                 thirteen rows a box per row is the loudest
                                 thing on the screen and it is never the
                                 thing the reader came for. -->
                            <td class="o_legal_col_state">
                                <span class="o_legal_state">
                                    <span t-attf-class="o_legal_state__dot o_legal_tone--{{ entry.row.state_tone }}"
                                          aria-hidden="true"/>
                                    <span class="o_legal_state__label"
                                          t-att-title="entry.row.state_label"
                                          t-esc="entry.row.state_label"/>
                                </span>
                            </td>

                            <!-- The column the screen exists for. Plain text:
                                 it is a sentence, and a sentence in a colour
                                 competes with the deadline beside it. -->
                            <td class="o_legal_col_why">
                                <span class="o_legal_why" t-att-title="entry.row.reason"
                                      t-esc="entry.row.reason"/>
                            </td>

                            <!-- Emphasised only when the clock has already
                                 bitten. A future date is information; an
                                 overdue one is an instruction. -->
                            <td class="o_legal_col_due">
                                <span t-attf-class="o_legal_due o_legal_due--{{ entry.row.due_tone }}"
                                      t-esc="entry.row.due_label"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <footer class="o_legal_panel__foot" t-if="props.queue.truncated">
                <span class="o_legal_panel__hint" t-esc="label.moreAbove"/>
                <span class="o_legal_pill o_legal_num" dir="ltr" t-esc="props.queue.more_label"/>
            </footer>
        </section>
    </t>

</templates>
