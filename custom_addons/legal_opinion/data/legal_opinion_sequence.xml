<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            OPN/YYYY/#### - the opinion reference. A plain ir.sequence, resetting
            on the calendar year, because an opinion number is ours alone and is
            never quoted back to us by a ministry the way a register number is.
        -->
        <record id="seq_legal_opinion" model="ir.sequence">
            <field name="name">Legal Opinion Reference</field>
            <field name="code">legal.opinion</field>
            <field name="prefix">OPN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
