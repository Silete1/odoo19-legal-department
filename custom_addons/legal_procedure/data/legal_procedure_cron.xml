<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Three scheduled jobs, and every one of them is written to be safe to
            run twice.

            That is not a nicety. Odoo 19's scheduler hands a job a time budget
            and expects it to report progress through ``ir.cron._commit_progress``;
            a long run is *interrupted* and resumed on the next pass, so a job
            that assumes it always finishes will silently skip the tail of the
            queue for ever. Each job below walks its whole population oldest
            first, commits after every record, and is idempotent by a unique
            index rather than by a flag somebody has to remember to set.
        -->

        <record id="cron_legal_deadline_scan" model="ir.cron">
            <field name="name">Legal: deadline scan and escalation</field>
            <field name="model_id" ref="model_legal_case"/>
            <field name="state">code</field>
            <field name="code">model._cron_deadline_scan()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_legal_obligation_generate" model="ir.cron">
            <field name="name">Legal: generate obligation periods</field>
            <field name="model_id" ref="model_legal_obligation_schedule"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_legal_obligation_late" model="ir.cron">
            <field name="name">Legal: mark obligation periods late</field>
            <field name="model_id" ref="model_legal_obligation_instance"/>
            <field name="state">code</field>
            <field name="code">model._cron_mark_late()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_legal_poa_expire" model="ir.cron">
            <field name="name">Legal: lapse expired powers of attorney</field>
            <field name="model_id" ref="model_legal_poa"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
