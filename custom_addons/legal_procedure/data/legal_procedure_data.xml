<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Shipped configuration is always noupdate="1". With noupdate="0" every
            module upgrade would overwrite the customer's edits, and the customer
            would learn that the hard way - at a counter, holding a letter that
            says what the vendor thought rather than what they typed.

            What ships here is deliberately thin: an activity type and a paper
            size. The procedures themselves belong to the jurisdiction packs,
            because a procedure shipped without a legal_basis and a
            last_verified_on is a liability, and one shipped with them is
            somebody's research rather than an engine's default.
        -->

        <record id="mail_activity_legal_chase" model="mail.activity.type">
            <field name="name">Chase The Counter</field>
            <field name="icon">fa-phone</field>
            <field name="delay_count">2</field>
            <field name="delay_unit">days</field>
            <field name="res_model">legal.case</field>
            <field name="summary">Ring the section and ask where the file is</field>
        </record>

        <record id="mail_activity_legal_collect" model="mail.activity.type">
            <field name="name">Collect From The Counter</field>
            <field name="icon">fa-hand-paper-o</field>
            <field name="delay_count">1</field>
            <field name="delay_unit">days</field>
            <field name="res_model">legal.case</field>
            <field name="summary">Go and pick it up</field>
        </record>

    </data>
</odoo>
