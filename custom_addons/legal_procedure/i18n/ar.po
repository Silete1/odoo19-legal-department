"“%(move)s” is blocked:\n"
"\n"
"%(reasons)s"
msgstr ""
"«%(move)s» متوقفة:\n"
"\n"
"%(reasons)s"

#. module: legal_procedure
#. odoo-python
#: code:addons/legal_procedure/models/legal_case.py:0
msgid "“%(move)s” is reserved for: %(groups)s."
msgstr "«%(move)s» محفوظة لـ: %(groups)s."

#. module: legal_procedure
#. odoo-python
#: code:addons/legal_procedure/models/legal_procedure_type.py:0
