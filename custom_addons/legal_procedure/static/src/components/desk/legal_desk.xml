<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="legal_procedure.LegalDesk">
        <Layout className="'o_legal_screen o_legal_desk'" display="{ controlPanel: {} }">

            <div class="o_legal_loading" t-if="!data and !state.error">
                <span class="o_legal_spinner" role="status" aria-hidden="true"/>
                <span t-esc="label.loading"/>
            </div>

            <div class="o_legal_error" t-if="!data and state.error" role="alert">
                <i t-attf-class="fa {{ state.error.permission ? 'fa-lock' : 'fa-exclamation-circle' }}"
                   role="img" aria-hidden="true"/>
                <div>
                    <p class="o_legal_error_title" t-esc="state.error.title"/>
                    <p class="o_legal_error_hint" t-esc="state.error.hint"/>
                    <button type="button" class="btn btn-primary btn-sm o_legal_retry"
                            t-if="!state.error.permission"
                            t-on-click="() => this.load()"
                            t-esc="label.retry"/>
                </div>
            </div>

            <div class="o_legal_body" t-if="data" t-att-dir="data.rtl ? 'rtl' : 'ltr'">

                <div class="o_legal_empty o_legal_card" t-if="!data.bodies.length">
                    <i class="fa fa-institution" role="img" aria-hidden="true"/>
                    <div>
                        <p class="o_legal_empty_title" t-esc="label.noBodies"/>
                        <p class="o_legal_empty_hint" t-esc="label.noBodiesHint"/>
                    </div>
                </div>

                <div class="o_legal_bodies" t-else="">
                    <LegalBodyDesk t-foreach="data.bodies" t-as="body" t-key="body.key"
                                   payload="body"
                                   onOpenRecord.bind="openRecord"
                                   onOpenAction.bind="doAction"/>
                </div>
            </div>
        </Layout>
    </t>

</templates>
