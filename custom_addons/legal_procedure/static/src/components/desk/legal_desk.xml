<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="legal_procedure.LegalDesk">
        <Layout className="'o_legal_screen o_legal_desk'" display="{ controlPanel: {} }">

            <div class="o_legal_loading" t-if="!data">
                <span class="o_legal_spinner" role="status" aria-hidden="true"/>
                <span t-esc="label.loading"/>
            </div>

            <div class="o_legal_body" t-if="data" t-att-dir="data.rtl ? 'rtl' : 'ltr'"
                 t-att-data-band="data.role.landing_band">

                <div class="o_legal_degraded" t-if="data.degraded.length" role="status">
                    <strong t-esc="label.degraded"/>
                    <span t-foreach="data.degraded" t-as="note" t-key="note_index" t-esc="note"/>
                </div>

                <!-- ============================================ BAND A - DESK -->
                <header class="o_legal_band_head">
                    <h2 class="o_legal_band_title" t-esc="label.deskBand"/>
                    <span class="o_legal_band_sub" t-esc="data.role.label"/>
                </header>

                <div class="o_legal_desk_grid">
                    <div class="o_legal_desk_left">
                        <section t-attf-class="o_legal_card o_legal_hero {{ data.hero.count ? 'o_legal_hero_active' : '' }}">
                            <span class="o_legal_hero_label" t-esc="data.hero.label"/>
                            <button type="button" class="o_legal_hero_value o_legal_num" dir="ltr"
                                    t-if="data.hero.count &amp;&amp; data.hero.action"
                                    t-on-click="() => this.doAction(data.hero.action)"
                                    t-esc="data.hero.count_label"/>
                            <span class="o_legal_hero_value o_legal_hero_zero o_legal_num"
                                  dir="ltr" t-else="" t-esc="data.hero.count_label"/>
                            <p class="o_legal_hero_note" t-esc="data.hero.note"/>
                            <p class="o_legal_hero_note" t-if="data.hero.oldest_label"
                               t-esc="data.hero.oldest_label"/>
                        </section>

                        <div class="o_legal_tiles">
                            <LegalKpiTile t-foreach="data.tiles" t-as="tile" t-key="tile.key"
                                          label="tile.label" value="tile.value"
                                          valueLabel="tile.value_label" hint="tile.hint"
                                          icon="tile.icon" tone="tile.tone"
                                          onOpen="tileOpen(tile)"/>
                        </div>
                    </div>

                    <LegalWorklist title="data.worklist.title" hint="data.worklist.hint"
                                   empty="data.worklist.empty" emptyHint="data.worklist.empty_hint"
                                   files="data.worklist.files" total="data.worklist.total"
                                   onOpenRecord.bind="openRecord"
                                   onOpenAll="() => this.doAction(data.worklist.action)"/>
                </div>

                <!-- ====================================== BAND B - THE BODIES -->
                <!-- What each counter wants, and when it is open. The desk above
                     says how much is on the reader; this says what to do with
                     it, which is the question a count cannot answer. -->
                <header class="o_legal_band_head">
                    <h2 class="o_legal_band_title" t-esc="label.bodiesBand"/>
                </header>

                <div class="o_legal_empty o_legal_card" t-if="!data.bodies.length">
                    <i class="fa fa-institution" role="img" aria-hidden="true"/>
                    <div>
                        <p class="o_legal_empty_title" t-esc="label.noBodies"/>
                        <p class="o_legal_empty_hint" t-esc="label.noBodiesHint"/>
                    </div>
                </div>

                <div class="o_legal_bodies" t-else="">
                    <LegalBodyDesk t-foreach="data.bodies" t-as="body" t-key="body.key"
                                   payload="body"
                                   onOpenRecord.bind="openRecord"
                                   onOpenAction.bind="doAction"/>
                </div>

                <!-- ======================================== BAND C - CASELOAD -->
                <header class="o_legal_band_head">
                    <h2 class="o_legal_band_title" t-esc="label.loadBand"/>
                    <button type="button" class="btn btn-link btn-sm"
                            t-if="!data.role.is_manager"
                            t-on-click="() => this.toggleLoad()"
                            t-att-aria-expanded="state.load"
                            t-esc="state.load ? label.hideLoad : label.showLoad"/>
                </header>

                <div class="o_legal_bodies" t-if="showsLoad">
                    <!-- The department's own bodies, at a glance. The heavier
                         analytics - median and p90 per step, our delay against
                         theirs - are the Performance screen, one click away and
                         deliberately NOT here: a desk that opens on a
                         percentile is a report, and the reader came for their
                         files. -->
                    <section class="o_legal_card" t-foreach="data.bodies" t-as="body"
                             t-key="body.key">
                        <h3 class="o_legal_card_title">
                            <span class="o_legal_chip o_legal_body_chip" t-esc="body.label"/>
                            <span class="o_legal_count o_legal_num" dir="ltr"
                                  t-esc="body.outstanding"/>
                        </h3>
                        <p class="o_legal_card_hint" t-if="body.open_hours"
                           dir="auto" t-esc="body.open_hours"/>
                    </section>
                </div>
            </div>
        </Layout>
    </t>

</templates>
