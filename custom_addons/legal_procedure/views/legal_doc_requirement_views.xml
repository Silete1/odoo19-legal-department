<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_legal_doc_requirement_list" model="ir.ui.view">
        <field name="name">legal.doc.requirement.list</field>
        <field name="model">legal.doc.requirement</field>
        <field name="arch" type="xml">
            <list string="Required Documents" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="procedure_type_id"/>
                <field name="document_type_id"/>
                <field name="step_id"/>
                <field name="is_required"/>
                <field name="per_subject"/>
                <field name="minimum_grade_id" optional="show"/>
                <field name="copies" optional="show"/>
                <field name="applicability_domain" optional="show"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_legal_doc_requirement_form" model="ir.ui.view">
        <field name="name">legal.doc.requirement.form</field>
        <field name="model">legal.doc.requirement</field>
        <field name="arch" type="xml">
            <form string="Required Document">
                <sheet>
                    <group>
                        <group string="What, And Where">
                            <field name="document_type_id"/>
                            <field name="procedure_type_id" options="{'no_create': True}"/>
                            <field name="step_id"/>
                            <field name="sequence"/>
                        </group>
                        <group string="How Strictly">
                            <field name="is_required"/>
                            <field name="per_subject"/>
                            <field name="minimum_grade_id"/>
                            <field name="copies"/>
                        </group>
                    </group>
                    <separator string="Only When"/>
                    <div class="alert alert-info" role="alert">
                        “An approval from the Ministry of Interior is needed if any founder is
                        foreign” belongs here as a filter, not in a Python branch nobody outside
                        the vendor can change. A condition that can never be true is refused when
                        this record is saved.
                    </div>
                    <field name="applicability_domain"
                           placeholder="[('subject_ids.nationality_id.code', '!=', 'IQ')]"/>
                    <separator string="What The Counter Actually Wants"/>
                    <field name="note"
                           placeholder="Stamped طبق الأصل, two copies, in the applicant's own folder."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_legal_doc_requirement_search" model="ir.ui.view">
        <field name="name">legal.doc.requirement.search</field>
        <field name="model">legal.doc.requirement</field>
        <field name="arch" type="xml">
            <search string="Required Documents">
                <field name="document_type_id"/>
                <field name="procedure_type_id"/>
                <field name="step_id"/>
                <filter name="required" string="Blocking" domain="[('is_required', '=', True)]"/>
                <filter name="conditional" string="Conditional" domain="[('applicability_domain', '!=', False)]"/>
                <filter name="per_subject" string="One Per Person" domain="[('per_subject', '=', True)]"/>
                <group>
                    <filter name="group_procedure" string="Procedure" context="{'group_by': 'procedure_type_id'}"/>
                    <filter name="group_document" string="Document" context="{'group_by': 'document_type_id'}"/>
                    <filter name="group_step" string="Step" context="{'group_by': 'step_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_legal_doc_requirement" model="ir.actions.act_window">
        <field name="name">Document Requirements</field>
        <field name="res_model">legal.doc.requirement</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_procedure': 1}</field>
    </record>

    <!--
        The edge legal_core deliberately does not know about: which procedure
        obtains a document type, and which one renews it. Added to core's own
        form rather than to a screen of its own, because it is the question a
        configurer asks while they are already looking at the document type.
    -->
    <record id="view_legal_document_type_form_procedure" model="ir.ui.view">
        <field name="name">legal.document.type.form.procedure</field>
        <field name="model">legal.document.type</field>
        <field name="inherit_id" ref="legal_core.view_legal_document_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='issuing_body_id']" position="after">
                <field name="producer_procedure_type_id"/>
                <field name="renewal_procedure_type_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_legal_case_document_list" model="ir.ui.view">
        <field name="name">legal.case.document.list</field>
        <field name="model">legal.case.document</field>
        <field name="arch" type="xml">
            <list string="Checklist" decoration-muted="superseded"
                  decoration-danger="line_status in ['rejected', 'expired', 'missing']"
                  decoration-success="line_status == 'accepted'">
                <field name="case_id"/>
                <field name="document_type_id"/>
                <field name="subject_id" optional="show"/>
                <field name="step_id" optional="hide"/>
                <field name="company_document_id"/>
                <field name="line_status" widget="badge"/>
                <field name="blocking_reason"/>
                <field name="is_blocking" optional="hide"/>
                <field name="round" optional="hide"/>
                <field name="superseded" column_invisible="True"/>
                <button name="action_mark_accepted" type="object" string="Accepted"
                        icon="fa-check" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_legal_case_document_search" model="ir.ui.view">
        <field name="name">legal.case.document.search</field>
        <field name="model">legal.case.document</field>
        <field name="arch" type="xml">
            <search string="Checklist">
                <field name="case_id"/>
                <field name="document_type_id"/>
                <field name="subject_id"/>
                <filter name="blocking" string="Blocking" domain="[('is_blocking', '=', True)]"/>
                <filter name="missing" string="Not Provided" domain="[('line_status', '=', 'missing')]"/>
                <filter name="expired" string="Expired" domain="[('line_status', '=', 'expired')]"/>
                <filter name="live" string="Current Round" domain="[('superseded', '=', False)]"/>
                <group>
                    <filter name="group_case" string="File" context="{'group_by': 'case_id'}"/>
                    <filter name="group_document" string="Document" context="{'group_by': 'document_type_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'line_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_legal_case_document_blocking" model="ir.actions.act_window">
        <field name="name">Blocking Documents</field>
        <field name="res_model">legal.case.document</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_blocking': 1, 'search_default_live': 1, 'search_default_group_case': 1}</field>
    </record>

</odoo>
