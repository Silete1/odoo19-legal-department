<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_legal_sla_rule_list" model="ir.ui.view">
        <field name="name">legal.sla.rule.list</field>
        <field name="model">legal.sla.rule</field>
        <field name="arch" type="xml">
            <list string="Service Levels" editable="bottom" class="o_legal_view">
                <field name="sequence" widget="handle"/>
                <field name="procedure_type_id"/>
                <field name="step_id"/>
                <field name="target_days"/>
                <field name="warning_days"/>
                <field name="escalation_days"/>
                <field name="escalate_to_group_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_legal_sla_rule_search" model="ir.ui.view">
        <field name="name">legal.sla.rule.search</field>
        <field name="model">legal.sla.rule</field>
        <field name="arch" type="xml">
            <search string="Service Levels">
                <field name="procedure_type_id"/>
                <field name="step_id"/>
                <filter name="fallback" string="Procedure Fallback" domain="[('step_id', '=', False)]"/>
                <group>
                    <filter name="group_procedure" string="Procedure" context="{'group_by': 'procedure_type_id'}"/>
                    <filter name="group_step" string="Step" context="{'group_by': 'step_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_legal_sla_rule" model="ir.actions.act_window">
        <field name="name">Service Levels</field>
        <field name="res_model">legal.sla.rule</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_procedure': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Say how long a step may sit</p>
            <p>
                Counted in the body's own working days, through the calendar on the body
                record. A target counted in calendar days cries wolf every Friday and goes
                berserk over Eid, and a chase list that is wrong four days in seven is one
                people learn to close without reading.
            </p>
        </field>
    </record>

</odoo>
