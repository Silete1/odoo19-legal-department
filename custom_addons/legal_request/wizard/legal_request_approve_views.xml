<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_legal_request_approve_form" model="ir.ui.view">
        <field name="name">legal.request.approve.form</field>
        <field name="model">legal.request.approve</field>
        <field name="arch" type="xml">
            <form string="Approve Request" class="o_legal_view">
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="decision"/>
                    <field name="note" required="decision == 'approved_conditional'"
                           placeholder="The conditions attached, or why the answer is signed as it stands."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Approve"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
