<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_legal_request_cancel_form" model="ir.ui.view">
        <field name="name">legal.request.cancel.form</field>
        <field name="model">legal.request.cancel</field>
        <field name="arch" type="xml">
            <form string="Cancel Request">
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="reason" required="1"
                           placeholder="Why the request is being dropped."/>
                </group>
                <div class="alert alert-warning" role="alert">
                    A cancelled request keeps its number and stays in the record. The reason is
                    what tells the requester, the manager and the auditor that this was a decision
                    and not a mistake.
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Cancel Request"
                            class="btn-primary"/>
                    <button string="Back" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
